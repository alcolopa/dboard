import { Theme } from "theme.slint";
import { AppState } from "state.slint";

// Entity-relationship diagram: one box per table, a line per foreign key.
export component Diagram inherits Rectangle {
    background: Theme.bg;
    clip: true;
    Flickable {
        content-width: max(AppState.er-width, parent.width);
        content-height: max(AppState.er-height, parent.height);
        for l in AppState.er-lines: Path {
            x: 0px; y: 0px;
            width: AppState.er-width; height: AppState.er-height;
            viewbox-width: AppState.er-width / 1px;
            viewbox-height: AppState.er-height / 1px;
            commands: l;
            stroke: Theme.dim; stroke-width: 1.2px;
        }
        for b in AppState.er-boxes: Rectangle {
            x: b.x; y: b.y; width: b.w; height: b.h;
            background: Theme.panel; border-radius: 6px; border-width: 1px; border-color: ta.has-hover ? Theme.accent : Theme.line;
            Rectangle {
                y: 0px; height: 24px; background: Theme.panel2; border-radius: 6px;
                Text { x: 8px; width: parent.width - 16px; text: b.title; font-weight: 700; font-size: 12px; color: Theme.text; vertical-alignment: center; overflow: elide; }
            }
            Text { x: 8px; y: 28px; width: parent.width - 16px; text: b.body; font-size: 11px; color: Theme.dim; font-family: "JetBrains Mono"; overflow: elide; }
            ta := TouchArea { double-clicked => { AppState.er-open(b.schema, b.name); } }
        }
    }
}
