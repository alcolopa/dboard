}

export component Icon inherits Rectangle {
    in property <string> d;
    in property <color> tint: Theme.text;
    in property <length> size: 16px;
    in property <bool> filled: false;
    width: size; height: size;
    Path {
        width: parent.width; height: parent.height;
        viewbox-width: 24; viewbox-height: 24;
        commands: root.d;
        stroke: root.tint;
        stroke-width: 1.7px;
        stroke-line-cap: round;
        stroke-line-join: round;
        fill: root.filled ? root.tint : transparent;
    }
}

/// Icon-only button. Its `hint` shows in the status area while hovered (there are no native tooltips).
export component IconBtn inherits Rectangle {
    in property <string> d;
    in property <string> hint;
    in property <bool> enabled: true;
    in property <bool> active: false;
    in property <bool> danger: false;
    in property <bool> primary: false;
    in property <bool> filled: false;
    in property <int> badge: 0;
    in property <length> size: 30px;
    callback clicked();
    width: size; height: size;
    border-radius: 6px;
    background: !enabled ? transparent
        : primary ? (ta.has-hover ? #4a6af0 : Theme.accent)
        : danger && ta.has-hover ? Theme.err-bg
        : active ? Theme.sel
        : ta.has-hover ? Theme.hover : transparent;
    opacity: enabled ? 1.0 : 0.35;
    Icon {
        d: root.d; filled: root.filled;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        tint: primary ? white : (danger && ta.has-hover ? Theme.err : (active ? Theme.accent : Theme.text));
    }
    if badge > 0: Rectangle {
        x: parent.width - bt.preferred-width - 8px; y: 1px;
        width: bt.preferred-width + 6px; height: 13px; border-radius: 6.5px; background: Theme.accent;
        bt := Text { text: root.badge; color: white; font-size: 9px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
    }
    ta := TouchArea {
        enabled: root.enabled;
        clicked => { AppState.hint = ""; root.clicked(); }
        changed has-hover => { AppState.hint = self.has-hover ? root.hint : ""; }
    }
}

/// Keeps a fixed-size child centred on the cross axis of a layout.
export component Slot inherits VerticalLayout {
    alignment: center;
    @children
}

export component Sep inherits Rectangle {
    width: 1px; height: 18px; background: Theme.line;
}

// Text inputs that respond to the native Edit menu (Cut / Copy / Paste / Select All) while focused.
export component EditLine inherits LineEdit {
    changed has-focus => { AppState.text-focus = max(0, AppState.text-focus + (self.has-focus ? 1 : -1)); }
    changed edit-seq => { if self.has-focus { self.run-edit(AppState.edit-kind); } }
    property <int> edit-seq: AppState.edit-seq;
    function run-edit(k: int) {
        if k == 0 { self.cut(); } else if k == 1 { self.copy(); } else if k == 2 { self.paste(); } else { self.select-all(); }
    }
}

export component EditArea inherits TextEdit {
    changed has-focus => { AppState.text-focus = max(0, AppState.text-focus + (self.has-focus ? 1 : -1)); }
    changed edit-seq => { if self.has-focus { self.run-edit(AppState.edit-kind); } }
    property <int> edit-seq: AppState.edit-seq;
    function run-edit(k: int) {
        if k == 0 { self.cut(); } else if k == 1 { self.copy(); } else if k == 2 { self.paste(); } else { self.select-all(); }
    }
}
