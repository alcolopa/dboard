import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Btn, Chip, Icons, Icon, Slot, Toolbar } from "widgets.slint";
import { SqlEditor } from "editor.slint";

export component QueryEditor inherits VerticalLayout {
    spacing: 6px;
    padding: 8px;
    Rectangle {
        height: 150px;
        border-radius: 6px; border-width: 1px; border-color: editor.has-focus ? Theme.accent : Theme.line; background: Theme.panel;
        editor := SqlEditor {
            width: parent.width; height: parent.height;
            text <=> AppState.query-text;
            font-size: AppState.set-font-size * 1px;
            edited(t) => { AppState.query-edited(t); }
        }
    }
    Toolbar {
        height: 40px; pad-x: 0px;
        Slot { Btn { text: AppState.running ? "Running…" : "▶ Run"; primary: true; enabled: !AppState.running && AppState.query-text != ""; clicked => { AppState.run-query(AppState.query-text); } } }
        Slot {
            Btn {
                text: "Run selection"; enabled: !AppState.running && AppState.query-text != "";
                // The editor widget doesn't expose its selection, so copy it through the clipboard
                // (the Rust side stashes and restores the user's clipboard around this).
                clicked => { AppState.stash-clipboard(); editor.copy(); AppState.run-selection(AppState.query-text); }
            }
        }
        Slot { Btn { text: "Explain"; enabled: !AppState.running && AppState.query-text != ""; clicked => { AppState.explain-query(AppState.query-text, false); } } }
        if AppState.db-type != 2: Slot { Btn { text: "Explain analyze"; enabled: !AppState.running && AppState.query-text != ""; clicked => { AppState.explain-query(AppState.query-text, true); } } }
        if AppState.running: Slot { Btn { text: "Stop"; danger: true; clicked => { AppState.stop-query(); } } }
        Slot { Btn { text: "Save…"; enabled: AppState.query-text != ""; clicked => { AppState.open-save-query(); } } }
        Slot { Btn { text: "History & saved"; clicked => { AppState.inspector-tab = 3; AppState.inspector-changed(true, AppState.inspector-pinned); } } }
        Rectangle { horizontal-stretch: 1; }
        Text { text: AppState.timing; color: Theme.dim; vertical-alignment: center; font-size: 12px; }
    }
    if AppState.result-labels.length > 1: Toolbar {
        height: 32px; pad-x: 0px;
        Text { text: "Results:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for l[i] in AppState.result-labels: Slot {
            Chip {
                text: l;
                active: AppState.result-index == i;
                clicked => { AppState.pick-result(i); }
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }
    if AppState.db-type == 2: Toolbar {
        height: 32px; pad-x: 0px;
        Text { text: "Templates:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for t in ["find", "$match", "$group", "$sort", "$project", "$limit"]: Slot { Chip { text: t; clicked => { AppState.insert-template(t); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if AppState.db-type != 2: Toolbar {
        height: 32px; pad-x: 0px;
        Text { text: "Snippets:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for t in [{ k: "select", l: "SELECT" }, { k: "count", l: "COUNT" }, { k: "group", l: "GROUP BY" }, { k: "join", l: "JOIN on FK" }, { k: "insert", l: "INSERT" }, { k: "update", l: "UPDATE" }, { k: "delete", l: "DELETE" }, { k: "cte", l: "WITH (CTE)" }]: Slot { Chip { text: t.l; clicked => { AppState.insert-template(t.k); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if AppState.suggestions.length > 0: Toolbar {
        height: 32px; pad-x: 0px;
        Text { text: "Suggest:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for s in AppState.suggestions: Slot { Chip { text: s; clicked => { AppState.apply-suggestion(s); } } }
        Rectangle { horizontal-stretch: 1; }
    }
    if AppState.query-hint != "": Text { text: AppState.query-hint; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
}

export component HistoryPanel inherits Rectangle {
    background: Theme.panel;
    VerticalLayout {
            padding: 8px;
        spacing: 8px;
        Text { text: "Saved queries"; font-weight: 700; color: Theme.text; }
        if AppState.saved.length == 0: Text { text: "Nothing saved yet. Use “Save…” in the editor."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
        ListView {
            max-height: 200px;
            for s[i] in AppState.saved: Rectangle {
                height: 36px; border-radius: 4px;
                background: sa.has-hover ? Theme.hover : Theme.clear;
                VerticalLayout {
                    x: 8px; width: parent.width - 40px; alignment: center;
                    Text { text: s.name; color: Theme.text; overflow: elide; }
                    Text { text: s.folder + " · " + s.sql; color: Theme.dim; font-size: 10px; overflow: elide; }
                }
                sa := TouchArea { clicked => { AppState.load-saved(i); } }
                Rectangle {
                    x: parent.width - 26px; width: 20px; height: 20px; y: 8px; border-radius: 10px;
                    background: da.has-hover ? Theme.panel2 : Theme.clear;
                    Icon { d: Icons.close; size: 10px; tint: Theme.dim; x: 5px; y: 5px; }
                    da := TouchArea { clicked => { AppState.delete-saved(i); } }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            Text { text: "History"; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Btn { text: "Clear"; clicked => { AppState.clear-history(); } }
        }
        if AppState.history.length == 0: Text { text: "Queries you run appear here."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
        ListView {
            vertical-stretch: 1;
            for h[i] in AppState.history: Rectangle {
                height: 38px; border-radius: 4px;
                background: ha.has-hover ? Theme.hover : Theme.clear;
                VerticalLayout {
                    x: 8px; width: parent.width - 16px; alignment: center;
                    Text { text: h.sql; color: h.ok ? Theme.text : Theme.err; overflow: elide; font-size: 12px; }
                    Text { text: h.meta; color: Theme.dim; font-size: 10px; overflow: elide; }
                }
                ha := TouchArea { clicked => { AppState.load-history(i); } }
            }
        }
    }
}
