import { TextEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Btn, Chip, EditLine, EditArea, Toolbar } from "widgets.slint";
import { SqlEditor } from "editor.slint";
import { HlToken } from "state.slint";

export component QueryEditor inherits VerticalLayout {
    spacing: 6px;
    padding: 8px;
    Rectangle {
        height: 150px;
        border-radius: 6px; border-width: 1px; border-color: Theme.line; background: Theme.panel;
        editor := SqlEditor {
            width: parent.width; height: parent.height;
            text <=> AppState.query-text;
            font-size: AppState.set-font-size * 1px;
            edited(t) => { AppState.query-edited(t); }
        }
    }
    Toolbar {
        height: 44px;
        Btn { text: "▶ Run"; primary: true; clicked => { AppState.run-query(AppState.query-text); } }
        Btn {
            text: "Run selection";
            // The editor widget doesn't expose its selection, so copy it through the clipboard
            // (the Rust side stashes and restores the user's clipboard around this).
            clicked => { AppState.stash-clipboard(); editor.copy(); AppState.run-selection(AppState.query-text); }
        }
        Btn { text: "Explain"; clicked => { AppState.explain-query(AppState.query-text, false); } }
        if AppState.db-type != 2: Btn { text: "Explain analyze"; clicked => { AppState.explain-query(AppState.query-text, true); } }
        Btn { text: "Save…"; clicked => { AppState.open-save-query(); } }
        Btn { text: "History & saved"; clicked => { AppState.inspector-tab = 3; AppState.inspector-changed(true, AppState.inspector-pinned); } }
        Rectangle { horizontal-stretch: 1; }
        Text { text: AppState.timing; color: Theme.dim; vertical-alignment: center; font-size: 12px; }
    }
    if AppState.result-labels.length > 1: HorizontalLayout {
        spacing: 6px; alignment: start;
        Text { text: "Results:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for l[i] in AppState.result-labels: Chip {
            text: l;
            fill: AppState.result-index == i ? Theme.accent : Theme.panel2;
            clicked => { AppState.pick-result(i); }
        }
    }
    if AppState.db-type == 2: HorizontalLayout {
        spacing: 6px; alignment: start;
        Text { text: "Templates:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for t in ["find", "$match", "$group", "$sort", "$project", "$limit"]: Chip { text: t; clicked => { AppState.insert-template(t); } }
    }
    if AppState.db-type != 2: HorizontalLayout {
        spacing: 6px; alignment: start;
        Text { text: "Snippets:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for t in [{ k: "select", l: "SELECT" }, { k: "count", l: "COUNT" }, { k: "group", l: "GROUP BY" }, { k: "join", l: "JOIN on FK" }, { k: "insert", l: "INSERT" }, { k: "update", l: "UPDATE" }, { k: "delete", l: "DELETE" }, { k: "cte", l: "WITH (CTE)" }]: Chip { text: t.l; clicked => { AppState.insert-template(t.k); } }
    }
    if AppState.suggestions.length > 0: HorizontalLayout {
        spacing: 6px; alignment: start;
        Text { text: "Suggest:"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
        for s in AppState.suggestions: Chip { text: s; clicked => { AppState.apply-suggestion(s); } }
    }
    if AppState.query-hint != "": Text { text: AppState.query-hint; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
}

export component HistoryPanel inherits Rectangle {
    background: Theme.panel;
    VerticalLayout {
            padding: 8px;
        spacing: 8px;
        Text { text: "Saved queries"; font-weight: 700; color: Theme.text; }
        if AppState.saved.length == 0: Text { text: "Nothing saved yet. Use “Save…” in the editor."; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
        ListView {
            max-height: 200px;
            for s[i] in AppState.saved: Rectangle {
                height: 36px; border-radius: 4px;
                background: sa.has-hover ? Theme.hover : transparent;
                VerticalLayout {
                    x: 8px; width: parent.width - 40px; alignment: center;
                    Text { text: s.name; color: Theme.text; overflow: elide; }
                    Text { text: s.folder + " · " + s.sql; color: Theme.dim; font-size: 10px; overflow: elide; }
                }
                sa := TouchArea { clicked => { AppState.load-saved(i); } }
                Rectangle {
                    x: parent.width - 26px; width: 20px; height: 20px; y: 8px; border-radius: 10px;
                    background: da.has-hover ? Theme.panel2 : transparent;
                    Text { text: "×"; color: Theme.dim; horizontal-alignment: center; vertical-alignment: center; }
                    da := TouchArea { clicked => { AppState.delete-saved(i); } }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        HorizontalLayout {
            Text { text: "History"; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            Btn { text: "Clear"; clicked => { AppState.clear-history(); } }
        }
        ListView {
            vertical-stretch: 1;
            for h[i] in AppState.history: Rectangle {
                height: 38px; border-radius: 4px;
                background: ha.has-hover ? Theme.hover : transparent;
                VerticalLayout {
                    x: 8px; width: parent.width - 16px; alignment: center;
                    Text { text: h.sql; color: h.ok ? Theme.text : Theme.err; overflow: elide; font-size: 12px; }
                    Text { text: h.meta; color: Theme.dim; font-size: 10px; overflow: elide; }
                }
                ha := TouchArea { clicked => { AppState.load-history(i); } }
            }
        }
    }
}
