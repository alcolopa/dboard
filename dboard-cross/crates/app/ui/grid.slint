import { ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState, GridCell, ColInfo } from "state.slint";
import { Icons, IconBtn } from "widgets.slint";

component GridCellView inherits Rectangle {
    in property <GridCell> cell;
    in property <ColInfo> col-info;
    in property <bool> editable;
    in property <bool> selected;
    in property <bool> anchor;
    in property <int> row-idx;
    in property <int> ci;
    property <bool> editing: false;
    property <int> token: AppState.edit-token;
    callback commit(string, bool);

    height: Theme.row-h;
    background: cell.state == 3 ? Theme.err-bg : (cell.state == 2 ? Theme.ok-bg : (selected ? Theme.sel : transparent));
    border-width: anchor ? 1.5px : 0.5px;
    border-color: anchor ? Theme.accent : Theme.line;
    clip: true;

    function start-edit() {
        if (root.editable && !root.col-info.is-json) {
            ti.text = root.cell.is-null ? "" : root.cell.text;
            root.editing = true;
            ti.focus();
            ti.select-all();
        } else if (root.editable) {
            AppState.open-json-cell(root.row-idx, root.ci);
        }
    }
    changed token => {
        if (AppState.edit-r == root.row-idx && AppState.edit-c == root.ci) {
            root.start-edit();
        }
    }

    // Declared first so the toggle / badges drawn after it receive clicks before it does.
    ta := TouchArea {
        pointer-event(e) => {
            if e.kind != PointerEventKind.down { return; }
            if e.button == PointerEventButton.left {
                AppState.select-cell(root.row-idx, root.ci, e.modifiers.shift);
            } else if e.button == PointerEventButton.right {
                if !root.selected {
                    AppState.select-cell(root.row-idx, root.ci, false);
                }
                AppState.ctx("cell", root.row-idx, root.ci, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
        double-clicked => { root.start-edit(); }
    }

    if !editing && !(col-info.is-bool && !cell.is-null && editable): Text {
        x: 8px; width: parent.width - (col-info.fk != "" ? 40px : 26px);
        text: cell.is-null ? "NULL" : cell.text;
        font-family: "JetBrains Mono"; font-size: 12px;
        color: cell.is-null ? Theme.dim : Theme.text;
        font-italic: cell.is-null;
        overflow: elide;
        vertical-alignment: center;
    }
    // Boolean: a real toggle
    if !editing && col-info.is-bool && !cell.is-null && editable: Rectangle {
        x: 8px; width: 36px; height: 16px; y: (parent.height - 16px) / 2; border-radius: 8px;
        background: (cell.text == "true" || cell.text == "1" || cell.text == "t") ? Theme.ok : Theme.dim;
        Rectangle {
            width: 12px; height: 12px; border-radius: 6px; background: white; y: 2px;
            x: (cell.text == "true" || cell.text == "1" || cell.text == "t") ? parent.width - 14px : 2px;
        }
        TouchArea { clicked => { AppState.toggle-bool(root.row-idx, root.ci); } }
    }
    if !editing && col-info.is-bool && !cell.is-null && editable: Text {
        x: 52px; text: cell.text; color: Theme.dim; font-size: 11px; vertical-alignment: center;
    }
    if !editing && col-info.fk != "" && !cell.is-null: Text {
        x: parent.width - (cell.state == 0 ? 18px : 34px); text: "→"; color: Theme.accent; vertical-alignment: center;
    }
    if !editing && cell.state == 1: Text { x: parent.width - 18px; text: "…"; color: Theme.dim; vertical-alignment: center; }
    if !editing && cell.state == 2: Text { x: parent.width - 18px; text: "✓"; color: Theme.ok; vertical-alignment: center; }
    if !editing && cell.state == 3: Text { x: parent.width - 18px; text: "!"; color: Theme.err; font-weight: 800; vertical-alignment: center; }

    Rectangle {
        visible: root.editing;
        background: Theme.panel2;
        border-width: 1px;
        border-color: Theme.accent;
        ti := TextInput {
            x: 8px; width: parent.width - 48px;
            color: Theme.text;
            single-line: true;
            vertical-alignment: center;
            accepted => { root.editing = false; root.commit(self.text, false); }
            key-pressed(e) => {
                if e.text == Key.Escape { root.editing = false; return accept; }
                if e.text == Key.Tab {
                    // Commit, then let the worker open the neighbouring cell once the grid has refreshed.
                    root.editing = false;
                    root.commit(self.text, false);
                    AppState.edit-next(root.row-idx, root.ci, 1);
                    return accept;
                }
                if e.text == Key.Backtab {
                    root.editing = false;
                    root.commit(self.text, false);
                    AppState.edit-next(root.row-idx, root.ci, -1);
                    return accept;
                }
                reject
            }
            changed has-focus => {
                if !self.has-focus && root.editing { root.editing = false; root.commit(self.text, false); }
            }
        }
        Rectangle {
            x: parent.width - 40px; width: 36px; height: 20px; y: (parent.height - 20px) / 2;
            background: Theme.line; border-radius: 3px;
            Text { text: "NULL"; font-size: 10px; color: Theme.text; }
            TouchArea { clicked => { root.editing = false; root.commit("", true); } }
        }
    }
}

export component DataGrid inherits Rectangle {
    background: Theme.bg;
    clip: true;

    pure function in-sel(r: int, c: int) -> bool {
        AppState.sel-kind != 0
            && r >= min(AppState.sel-r0, AppState.sel-r1) && r <= max(AppState.sel-r0, AppState.sel-r1)
            && c >= min(AppState.sel-c0, AppState.sel-c1) && c <= max(AppState.sel-c0, AppState.sel-c1)
    }
    pure function col-sel(c: int) -> bool {
        AppState.sel-kind == 2 && c >= min(AppState.sel-c0, AppState.sel-c1) && c <= max(AppState.sel-c0, AppState.sel-c1)
    }
    pure function row-sel(r: int) -> bool {
        AppState.sel-kind == 3 && r >= min(AppState.sel-r0, AppState.sel-r1) && r <= max(AppState.sel-r0, AppState.sel-r1)
    }

    Flickable {
        content-width: max(self.width, 48px + AppState.grid-width);
        content-height: self.height;
        VerticalLayout {
            width: max(parent.width, 48px + AppState.grid-width);
            height: parent.height;
            alignment: stretch;
            // ---- header ----
            HorizontalLayout {
                height: 34px;
                Rectangle {
                    width: 48px; background: Theme.panel; border-width: 0.5px; border-color: Theme.line;
                    Text { text: "all"; color: Theme.dim; font-size: 10px; horizontal-alignment: center; vertical-alignment: center; }
                    TouchArea { clicked => { AppState.select-all(); } }
                }
                for col[c] in AppState.cols: Rectangle {
                    width: AppState.col-widths[c];
                    background: root.col-sel(c) ? Theme.sel : Theme.panel;
                    border-width: 0.5px; border-color: Theme.line;
                    Text {
                        x: 8px; y: 4px; width: parent.width - 34px;
                        text: col.name;
                        font-weight: 700; color: Theme.text; overflow: elide; font-size: 12px;
                    }
                    Text {
                        x: 8px; y: 19px; width: parent.width - 34px;
                        text: (col.pk ? "PK · " : "") + (col.fk != "" ? "FK → " + col.fk + " · " : "") + col.type-name;
                        font-size: 9px; color: Theme.dim; overflow: elide;
                    }
                    // Click selects the whole column (Shift extends); the arrow sorts.
                    TouchArea {
                        width: parent.width - 30px;
                        pointer-event(e) => {
                            if e.kind != PointerEventKind.down { return; }
                            if e.button == PointerEventButton.left {
                                AppState.select-column(c, e.modifiers.shift);
                            } else if e.button == PointerEventButton.right {
                                if !root.col-sel(c) { AppState.select-column(c, false); }
                                AppState.ctx("header", c, c, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 28px; y: 6px; width: 20px; height: 22px; border-radius: 4px;
                        background: sa.has-hover ? Theme.hover : transparent;
                        Text {
                            text: AppState.sort-column == col.name ? (AppState.sort-asc ? "▲" : "▼") : "⇅";
                            color: AppState.sort-column == col.name ? Theme.accent : Theme.dim;
                            font-size: 11px; horizontal-alignment: center; vertical-alignment: center;
                        }
                        sa := TouchArea { clicked => { AppState.sort-by(c); } }
                    }
                    // drag handle to resize
                    Rectangle {
                        x: parent.width - 6px; width: 6px;
                        background: rh.has-hover || rh.pressed ? Theme.accent : transparent;
                        rh := TouchArea {
                            mouse-cursor: MouseCursor.col-resize;
                            moved => {
                                AppState.col-widths[c] = max(60px, AppState.col-widths[c] + (self.mouse-x - self.pressed-x));
                            }
                            pointer-event(e) => {
                                if e.kind == PointerEventKind.up { AppState.col-resized(c, AppState.col-widths[c]); }
                            }
                        }
                    }
                }
            }
            // ---- new row, typed straight into the table ----
            if AppState.draft-open: HorizontalLayout {
                height: Theme.row-h + 8px;
                Rectangle {
                    width: 48px; background: Theme.sel; border-width: 0.5px; border-color: Theme.accent;
                    IconBtn { x: 2px; y: 4px; size: 20px; d: Icons.check; primary: true; hint: "Insert row (Enter)"; clicked => { AppState.draft-submit(AppState.draft); } }
                    IconBtn { x: 24px; y: 4px; size: 20px; d: Icons.close; hint: "Discard (Esc)"; clicked => { AppState.draft-open = false; } }
                }
                for hint[c] in AppState.draft-hints: Rectangle {
                    width: AppState.col-widths[c];
                    background: Theme.panel2; border-width: 0.5px; border-color: Theme.accent;
                    clip: true;
                    Text {
                        x: 8px; width: parent.width - 12px; visible: dti.text == "";
                        text: hint; color: Theme.dim; font-italic: true; font-size: 11px; overflow: elide; vertical-alignment: center;
                    }
                    dti := TextInput {
                        x: 8px; width: parent.width - 12px;
                        color: Theme.text; single-line: true; vertical-alignment: center;
                        init => { if c == 0 { self.focus(); } }
                        edited => { AppState.draft[c] = self.text; }
                        accepted => { AppState.draft-submit(AppState.draft); }
                        key-pressed(e) => {
                            if e.text == Key.Escape { AppState.draft-open = false; return accept; }
                            reject
                        }
                    }
                }
            }
            // ---- rows (virtualised) ----
            ListView {
                for row[r] in AppState.rows: HorizontalLayout {
                    height: Theme.row-h;
                    Rectangle {
                        width: 48px;
                        background: root.row-sel(r) ? Theme.sel : Theme.panel;
                        border-width: 0.5px; border-color: Theme.line;
                        Text { text: "" + (AppState.row-offset + r + 1); color: Theme.dim; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea {
                            pointer-event(e) => {
                                if e.kind != PointerEventKind.down { return; }
                                if e.button == PointerEventButton.left {
                                    AppState.select-row(r, e.modifiers.shift);
                                } else if e.button == PointerEventButton.right {
                                    if !root.row-sel(r) { AppState.select-row(r, false); }
                                    AppState.ctx("row", r, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                                }
                            }
                        }
                    }
                    for cell[c] in row: GridCellView {
                        width: AppState.col-widths[c];
                        cell: cell;
                        col-info: AppState.cols[c];
                        row-idx: r;
                        ci: c;
                        editable: AppState.editable;
                        selected: root.in-sel(r, c);
                        anchor: AppState.sel-kind == 1 && r == AppState.sel-r1 && c == AppState.sel-c1;
                        commit(t, n) => { AppState.edit-cell(r, c, t, n); AppState.focus-token += 1; }
                    }
                }
            }
        }
    }
    if AppState.rows.length == 0 && AppState.cols.length > 0: Text {
        text: "No rows"; color: Theme.dim; horizontal-alignment: center; vertical-alignment: center;
    }
}
