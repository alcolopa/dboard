import { ListView, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Btn, Icons, IconBtn, Icon } from "widgets.slint";

import { HistoryPanel } from "query.slint";

export component Inspector inherits Rectangle {
    width: 320px;
    background: Theme.panel;
    drop-shadow-blur: AppState.inspector-pinned ? 0px : 16px;
    drop-shadow-color: #00000055;
    drop-shadow-offset-x: -4px;
    TouchArea { } // swallow clicks so an unpinned inspector does not close itself
    VerticalLayout {
        HorizontalLayout {
            height: 34px; padding-left: 8px; spacing: 2px;
            Text { text: "Inspector"; color: Theme.text; font-weight: 700; vertical-alignment: center; }
            Rectangle { horizontal-stretch: 1; }
            // Pin keeps the inspector open across restarts; unpinned closes on an outside click.
            IconBtn {
                y: 5px; size: 24px; d: Icons.pin; filled: AppState.inspector-pinned; active: AppState.inspector-pinned;
                hint: AppState.inspector-pinned ? "Unpin inspector" : "Pin inspector";
                clicked => { AppState.inspector-changed(true, !AppState.inspector-pinned); }
            }
            IconBtn {
                y: 5px; size: 24px; d: Icons.close; hint: "Close inspector";
                clicked => { AppState.inspector-changed(false, AppState.inspector-pinned); }
            }
        }
        HorizontalLayout {
            height: 34px; spacing: 2px;
            for name[i] in ["Activity", "Changes", "Info", "History"]: Rectangle {
                horizontal-stretch: 1; min-width: 0px;
                Text { text: name; color: AppState.inspector-tab == i ? Theme.text : Theme.dim; font-size: 12px; font-weight: AppState.inspector-tab == i ? 700 : 400; horizontal-alignment: center; vertical-alignment: center; }
                Rectangle { y: parent.height - 2px; height: 2px; background: AppState.inspector-tab == i ? Theme.accent : transparent; }
                TouchArea { clicked => { AppState.inspector-tab = i; } }
            }
        }
        Rectangle { height: 1px; background: Theme.line; }
        if AppState.inspector-tab == 0: VerticalLayout {
            padding: 8px; spacing: 6px;
            HorizontalLayout {
                Text { text: "Live activity log"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                IconBtn { d: Icons.trash; size: 24px; hint: "Clear log"; clicked => { AppState.clear-activity(); } }
            }
            ListView {
                for line in AppState.activity: Text {
                    text: line; color: Theme.text; font-size: 11px; wrap: word-wrap; height: 30px; overflow: elide;
                }
            }
        }
        if AppState.inspector-tab == 1: VerticalLayout {
            padding: 8px; spacing: 6px;
            HorizontalLayout {
                Text { text: AppState.undo-count + " change(s) you can undo"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                IconBtn { d: Icons.undo; size: 24px; hint: "Undo last change"; enabled: AppState.undo-count > 0; clicked => { AppState.undo(); } }
            }
            if AppState.edit-items.length == 0: Text {
                text: "Edits and deleted rows appear here, newest first. Each one can be undone."; color: Theme.dim; font-size: 11px; wrap: word-wrap;
            }
            ListView {
                for it[i] in AppState.edit-items: Rectangle {
                    height: 44px; border-radius: 4px;
                    background: ea.has-hover ? Theme.hover : transparent;
                    VerticalLayout {
                        x: 6px; width: parent.width - 46px; alignment: center; spacing: 1px;
                        Text { text: it.text; color: Theme.text; font-size: 11px; overflow: elide; }
                        Text { text: it.detail; color: Theme.dim; font-size: 10px; overflow: elide; }
                    }
                    ea := TouchArea { }
                    if it.can-undo: IconBtn { x: parent.width - 34px; y: 7px; size: 30px; d: Icons.undo; hint: "Undo this change"; clicked => { AppState.undo-entry(i); } }
                }
            }
        }
        if AppState.inspector-tab == 3: HistoryPanel { }
        if AppState.inspector-tab == 2: ScrollView {
            VerticalLayout {
                padding: 14px; spacing: 10px; alignment: start;
                for row in AppState.meta-rows: VerticalLayout {
                    spacing: 2px;
                    if row.label == "": Rectangle { height: 8px; }
                    if row.label != "" && row.value == "": Text {
                        text: row.label; color: Theme.accent; font-size: 11px; font-weight: 700;
                    }
                    if row.label != "" && row.value != "": Text { text: row.label; color: Theme.dim; font-size: 10px; }
                    if row.label != "" && row.value != "": Text { text: row.value; color: Theme.text; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }
}
