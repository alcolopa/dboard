import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState, TreeItem } from "state.slint";

component KindBadge inherits Rectangle {
    in property <int> kind;
    width: 16px; height: 16px; border-radius: 3px;
    background: kind == 2 ? #3b82f6 : kind == 3 ? #a855f7 : kind == 4 ? #ec4899 : kind == 5 ? #10b981 : kind == 6 ? #f59e0b : kind == 7 ? #f97316 : #64748b;
    Text {
        text: kind == 2 ? "T" : kind == 3 ? "V" : kind == 4 ? "M" : kind == 5 ? "C" : kind == 6 ? "ƒ" : kind == 7 ? "P" : "#";
        color: white; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center;
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.panel;
    VerticalLayout {
        padding: 8px; spacing: 8px;
        LineEdit {
            placeholder-text: "Filter objects";
            text <=> AppState.tree-filter;
            edited(t) => { AppState.filter-tree(t); }
        }
        if AppState.tree.length == 0: Text {
            text: AppState.tree-filter == "" ? "No tables found." : "No matches.";
            color: Theme.dim; font-size: 12px;
        }
        ListView {
            for item[i] in AppState.tree: Rectangle {
                height: 26px;
                background: ta.has-hover ? Theme.hover : transparent;
                border-radius: 4px;

                if item.kind <= 1: Text {
                    x: item.kind == 0 ? 4px : 16px;
                    text: (item.expanded ? "▾ " : "▸ ") + item.label;
                    color: item.kind == 0 ? Theme.text : Theme.dim;
                    font-size: item.kind == 0 ? 12px : 11px;
                    font-weight: item.kind == 0 ? 700 : 600;
                    vertical-alignment: center;
                    overflow: elide; width: parent.width - 8px;
                }
                if item.kind > 1: KindBadge { x: 30px; y: 5px; kind: item.kind; }
                if item.kind > 1: Text {
                    x: 52px; width: parent.width - 58px;
                    text: item.label; color: Theme.text; overflow: elide; vertical-alignment: center;
                }

                ContextMenuArea {
                    Menu {
                        MenuItem { title: "Open data"; enabled: item.kind >= 2 && item.kind <= 5; activated => { AppState.tree-action(i, "open"); } }
                        MenuItem { title: item.kind >= 6 ? "View definition" : "Inspect structure"; enabled: item.kind >= 2; activated => { AppState.tree-action(i, "structure"); } }
                        MenuItem { title: "Query…"; enabled: item.kind >= 2 && item.kind <= 5; activated => { AppState.tree-action(i, "query"); } }
                        MenuItem { title: "Insert row…"; enabled: item.kind == 2 || item.kind == 5; activated => { AppState.tree-action(i, "insert"); } }
                        MenuItem { title: "Export data…"; enabled: item.kind >= 2 && item.kind <= 5; activated => { AppState.tree-action(i, "export"); } }
                        MenuSeparator { }
                        MenuItem { title: "Truncate…"; enabled: item.kind == 2 || item.kind == 5; activated => { AppState.tree-action(i, "truncate"); } }
                        MenuItem { title: "Drop…"; enabled: item.kind >= 2 && item.kind <= 5; activated => { AppState.tree-action(i, "drop"); } }
                        MenuSeparator { }
                        MenuItem { title: "Copy name"; enabled: item.kind >= 2; activated => { AppState.tree-action(i, "copy"); } }
                    }
                    ta := TouchArea { clicked => { AppState.tree-click(i); } }
                }
            }
        }
    }
}
