import { LineEdit, ListView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState, TreeItem } from "state.slint";
import { Icons, IconBtn, Slot, EditLine, EditArea, Btn } from "widgets.slint";

component KindBadge inherits Rectangle {
    in property <int> kind;
    width: 16px; height: 16px; border-radius: 3px;
    background: kind == 2 ? #3b82f6 : kind == 3 ? #a855f7 : kind == 4 ? #ec4899 : kind == 5 ? #10b981 : kind == 6 ? #f59e0b : kind == 7 ? #f97316
        : kind == 9 ? #ef4444 : kind == 10 ? #06b6d4 : kind == 11 ? #84cc16 : kind == 12 ? #14b8a6 : kind == 13 ? #8b5cf6 : #64748b;
    Text {
        text: kind == 2 ? "T" : kind == 3 ? "V" : kind == 4 ? "M" : kind == 5 ? "C" : kind == 6 ? "ƒ" : kind == 7 ? "P" : kind == 9 ? "R" : kind == 10 ? "Y" : kind == 11 ? "I" : kind == 12 ? "E" : kind == 13 ? "X" : "#";
        color: white; font-size: 9px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center;
    }
}

export component Sidebar inherits Rectangle {
    background: Theme.panel;
    VerticalLayout {
        padding: 8px; spacing: 8px;
        // Outside the ListView, so it stays put while the object list scrolls.
        HorizontalLayout {
            spacing: 6px;
            EditLine {
                placeholder-text: "Filter objects";
                text <=> AppState.tree-filter;
                edited(t) => { AppState.filter-tree(t); }
                horizontal-stretch: 1;
            }
            Slot { IconBtn { d: Icons.refresh; hint: "Refresh tables & metadata (" + Theme.mod + "+R)"; clicked => { AppState.refresh(); } } }
        }
        if AppState.tree.length == 0: Text {
            text: AppState.tree-filter == "" ? "No tables found." : "No matches.";
            color: Theme.dim; font-size: 12px;
        }
        if AppState.tree-sel-count > 0: HorizontalLayout {
            spacing: 6px;
            Text { text: AppState.tree-sel-count + " selected"; color: Theme.dim; font-size: 12px; vertical-alignment: center; horizontal-stretch: 1; }
            Btn { text: "Drop…"; danger: true; clicked => { AppState.tree-drop-selected(); } }
            Btn { text: "Clear"; clicked => { AppState.tree-clear-selection(); } }
        }
        ListView {
            for item[i] in AppState.tree: root-rect := Rectangle {
                height: 26px;
                // 1 = Ctrl/Cmd held when the button went down, 2 = Shift
                property <int> sel-mode;
                background: item.selected ? Theme.sel : ta.has-hover ? Theme.hover : transparent;
                border-radius: 4px;

                if item.kind <= 1: Text {
                    x: item.kind == 0 ? 4px : 16px;
                    text: (item.expanded ? "▾ " : "▸ ") + item.label;
                    color: item.kind == 0 ? Theme.text : Theme.dim;
                    font-size: item.kind == 0 ? 12px : 11px;
                    font-weight: item.kind == 0 ? 700 : 600;
                    vertical-alignment: center;
                    overflow: elide; width: parent.width - 8px;
                }
                if item.kind > 1: KindBadge { x: 30px; y: 5px; kind: item.kind; }
                if item.kind > 1: Text {
                    x: 52px; width: parent.width - 58px;
                    text: item.label; color: Theme.text; overflow: elide; vertical-alignment: center;
                }

                ta := TouchArea {
                    clicked => {
                        if item.kind >= 2 && item.kind <= 5 && root-rect.sel-mode != 0 { AppState.tree-select(i, root-rect.sel-mode); }
                        else { AppState.tree-click(i); }
                    }
                    pointer-event(e) => {
                        if e.button == PointerEventButton.left && e.kind == PointerEventKind.down {
                            root-rect.sel-mode = (e.modifiers.control || e.modifiers.meta) ? 1 : e.modifiers.shift ? 2 : 0;
                        }
                        if e.button == PointerEventButton.right && e.kind == PointerEventKind.down && item.kind >= 2 {
                            AppState.ctx("tree", i, 0, self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
            }
        }
        if AppState.tree.length > 0: Btn { text: "Drop all tables…"; danger: true; clicked => { AppState.tree-drop-all(); } }
    }
}
