import { Button, LineEdit, ComboBox, TextEdit, ListView, Palette } from "std-widgets.slint";

export struct GridCell { text: string, is-null: bool, state: int }
export struct TreeItem { label: string, header: bool, schema: string, name: string }

global Theme {
    out property <color> bg: #0f1115;
    out property <color> panel: #161922;
    out property <color> line: #262b38;
    out property <color> text: #e6e8ee;
    out property <color> dim: #8b91a3;
    out property <color> accent: #6d8cff;
    out property <color> ok: #10b981;
    out property <color> err: #ef4444;
}

component GridCellView inherits Rectangle {
    in property <GridCell> cell;
    in property <bool> editable;
    in property <length> col-width: 170px;
    property <bool> editing: false;
    callback commit(string, bool);

    width: col-width;
    height: 30px;
    background: cell.state == 3 ? #3a1519 : (cell.state == 2 ? #10291f : transparent);
    border-width: 0.5px;
    border-color: Theme.line;
    clip: true;

    if !editing: Text {
        x: 8px; width: parent.width - 30px;
        text: cell.is-null ? "NULL" : cell.text;
        color: cell.is-null ? Theme.dim : Theme.text;
        font-italic: cell.is-null;
        overflow: elide;
        vertical-alignment: center;
    }
    if !editing && cell.state == 1: Text { x: parent.width - 20px; text: "…"; color: Theme.dim; vertical-alignment: center; }
    if !editing && cell.state == 2: Text { x: parent.width - 20px; text: "✓"; color: Theme.ok; vertical-alignment: center; }
    if !editing && cell.state == 3: Text { x: parent.width - 20px; text: "!"; color: Theme.err; font-weight: 800; vertical-alignment: center; }

    ta := TouchArea {
        double-clicked => {
            if root.editable {
                ti.text = root.cell.is-null ? "" : root.cell.text;
                root.editing = true;
                ti.focus();
                ti.select-all();
            }
        }
    }

    Rectangle {
        visible: root.editing;
        background: #1d2230;
        border-width: 1px;
        border-color: Theme.accent;
        ti := TextInput {
            x: 8px; width: parent.width - 44px;
            color: Theme.text;
            single-line: true;
            vertical-alignment: center;
            accepted => { root.editing = false; root.commit(self.text, false); }
            key-pressed(e) => {
                if e.text == Key.Escape { root.editing = false; return accept; }
                reject
            }
            changed has-focus => {
                if !self.has-focus && root.editing { root.editing = false; root.commit(self.text, false); }
            }
        }
        Rectangle {
            x: parent.width - 38px; width: 36px; height: 20px; y: (parent.height - 20px) / 2;
            background: Theme.line; border-radius: 3px;
            Text { text: "NULL"; font-size: 10px; color: Theme.text; }
            TouchArea { clicked => { root.editing = false; root.commit("", true); } }
        }
    }
}

export component App inherits Window {
    title: "dboard";
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-size: 13px;
    init => { Palette.color-scheme = ColorScheme.dark; }

    // ---- connection form ----
    in-out property <string> conn-host: "localhost";
    in-out property <string> conn-port: "5432";
    in-out property <string> conn-db: "postgres";
    in-out property <string> conn-user: "postgres";
    in-out property <string> conn-password;
    in-out property <int> conn-env: 3;
    in property <[string]> env-names: ["Production", "Staging", "Development", "Local"];
    in property <[color]> env-colors: [#EF4444, #F59E0B, #3B82F6, #10B981];
    in property <bool> connected;
    in property <bool> busy;
    in property <string> status;
    in property <string> error;
    callback connect();
    callback disconnect();

    // ---- workspace ----
    in property <[TreeItem]> tree;
    in property <[string]> columns;
    in property <[[GridCell]]> rows;
    in property <string> table-title;
    in property <string> page-info;
    in property <string> timing;
    in property <string> sort-label;
    in property <bool> editable;
    in property <string> banner;
    in property <[string]> log;
    in property <int> undo-count;
    in-out property <int> mode: 0; // 0 = table, 1 = query
    in-out property <string> tree-filter;
    in-out property <string> filter-text;
    in-out property <string> query-text: "SELECT version();";

    // Destructive confirmation (production / staging)
    in property <bool> confirm-open;
    in property <string> confirm-sql;
    in-out property <string> confirm-typed;

    callback open-table(int);
    callback filter-tree(string);
    callback edit-cell(int, int, string, bool);
    callback undo();
    callback next-page();
    callback prev-page();
    callback sort-by(int);
    callback apply-filter(string);
    callback refresh();
    callback run-query(string);
    callback confirm-run();
    callback confirm-cancel();

    if !connected: Rectangle {
        background: Theme.bg;
        Rectangle {
            width: 440px; height: form.preferred-height + 48px;
            background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.line;
            form := VerticalLayout {
                padding: 24px; spacing: 10px;
                Text { text: "dboard"; font-size: 22px; font-weight: 700; color: Theme.text; }
                Text { text: "Connect to PostgreSQL"; color: Theme.dim; }
                HorizontalLayout { spacing: 8px;
                    LineEdit { placeholder-text: "Host"; text <=> root.conn-host; }
                    LineEdit { placeholder-text: "Port"; text <=> root.conn-port; width: 90px; }
                }
                LineEdit { placeholder-text: "Database"; text <=> root.conn-db; }
                LineEdit { placeholder-text: "User"; text <=> root.conn-user; }
                LineEdit { placeholder-text: "Password"; input-type: password; text <=> root.conn-password; accepted => { root.connect(); } }
                ComboBox { model: root.env-names; current-index <=> root.conn-env; }
                if root.error != "": Text { text: root.error; color: Theme.err; wrap: word-wrap; }
                Button { text: root.busy ? "Connecting…" : "Connect"; primary: true; enabled: !root.busy; clicked => { root.connect(); } }
            }
        }
    }

    if connected: VerticalLayout {
        // top bar
        Rectangle {
            height: 40px; background: Theme.panel;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px; spacing: 10px;
                Rectangle {
                    width: envlbl.preferred-width + 16px; height: 22px; y: 9px;
                    background: root.env-colors[root.conn-env]; border-radius: 11px;
                    envlbl := Text { text: root.env-names[root.conn-env]; color: white; font-size: 11px; font-weight: 700; }
                }
                Text { text: root.status; color: Theme.dim; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Button { text: "Undo (" + root.undo-count + ")"; enabled: root.undo-count > 0; clicked => { root.undo(); } }
                Button { text: "Refresh"; clicked => { root.refresh(); } }
                Button { text: "Disconnect"; clicked => { root.disconnect(); } }
            }
        }
        Rectangle {
            vertical-stretch: 1;
            // sidebar
            Rectangle {
                x: 0px; width: 260px; height: parent.height; background: Theme.panel;
                VerticalLayout {
                    padding: 8px; spacing: 8px;
                    LineEdit { placeholder-text: "Filter objects"; text <=> root.tree-filter; edited(t) => { root.filter-tree(t); } }
                    ListView {
                        for item[i] in root.tree: Rectangle {
                            height: 26px;
                            background: !item.header && ta-t.has-hover ? #1f2431 : transparent;
                            Text {
                                x: item.header ? 4px : 16px;
                                text: item.label;
                                color: item.header ? Theme.dim : Theme.text;
                                font-size: item.header ? 11px : 13px;
                                font-weight: item.header ? 700 : 400;
                                vertical-alignment: center;
                            }
                            ta-t := TouchArea { enabled: !item.header; clicked => { root.mode = 0; root.open-table(i); } }
                        }
                    }
                }
            }
            // workspace
            Rectangle {
              x: 260px; width: parent.width - 260px; height: parent.height;
              VerticalLayout {
                // tabs
                Rectangle {
                    height: 34px; background: Theme.bg;
                    HorizontalLayout {
                        padding-left: 8px; spacing: 4px;
                        for name[i] in ["Data", "SQL Query"]: Rectangle {
                            width: 100px;
                            background: root.mode == i ? Theme.panel : transparent;
                            Text { text: name; color: root.mode == i ? Theme.text : Theme.dim; }
                            TouchArea { clicked => { root.mode = i; } }
                        }
                    }
                }
                if root.mode == 1: VerticalLayout {
                    height: 150px; padding: 8px; spacing: 6px;
                    TextEdit { text <=> root.query-text; font-size: 13px; }
                    HorizontalLayout { spacing: 8px;
                        Button { text: "Run"; primary: true; clicked => { root.run-query(root.query-text); } }
                        Text { text: root.timing; color: Theme.dim; vertical-alignment: center; }
                    }
                }
                if root.mode == 0: HorizontalLayout {
                    height: 44px; padding: 8px; spacing: 8px;
                    Text { text: root.table-title; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    LineEdit {
                        placeholder-text: "WHERE clause, e.g. id > 10";
                        text <=> root.filter-text;
                        accepted => { root.apply-filter(self.text); }
                        horizontal-stretch: 1;
                    }
                    Button { text: "Apply"; clicked => { root.apply-filter(root.filter-text); } }
                }
                if root.banner != "": Rectangle {
                    height: 26px; background: #3a2a10;
                    Text { x: 12px; text: root.banner; color: #f5c46b; vertical-alignment: center; }
                }
                // grid
                Flickable {
                    content-width: max(self.width, root.columns.length * 170px);
                    content-height: self.height;
                    VerticalLayout {
                        HorizontalLayout {
                            height: 30px;
                            for col[c] in root.columns: Rectangle {
                                width: 170px; background: Theme.panel;
                                border-width: 0.5px; border-color: Theme.line;
                                Text { x: 8px; text: col + (root.sort-label == col ? " ▲▼" : ""); font-weight: 700; color: Theme.text; vertical-alignment: center; }
                                TouchArea { clicked => { root.sort-by(c); } }
                            }
                        }
                        ListView {
                            for row[r] in root.rows: HorizontalLayout {
                                height: 30px;
                                for cell[c] in row: GridCellView {
                                    cell: cell;
                                    editable: root.editable && root.mode == 0;
                                    commit(t, n) => { root.edit-cell(r, c, t, n); }
                                }
                            }
                        }
                    }
                }
                // footer
                Rectangle {
                    height: 34px; background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 12px; padding-right: 12px; spacing: 8px;
                        if root.mode == 0: Button { text: "‹ Prev"; clicked => { root.prev-page(); } }
                        if root.mode == 0: Button { text: "Next ›"; clicked => { root.next-page(); } }
                        Text { text: root.page-info; color: Theme.dim; vertical-alignment: center; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: root.log.length > 0 ? root.log[0] : ""; color: Theme.dim; overflow: elide; vertical-alignment: center; horizontal-stretch: 2; }
                    }
                }
            }
            }
        }
    }

    if confirm-open: Rectangle {
        background: #000000aa;
        TouchArea { }
        Rectangle {
            width: 480px; height: cv.preferred-height + 40px;
            background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.err;
            cv := VerticalLayout {
                padding: 20px; spacing: 10px;
                Text { text: "Destructive statement on " + root.env-names[root.conn-env]; color: Theme.err; font-weight: 700; }
                Text { text: root.confirm-sql; color: Theme.text; wrap: word-wrap; }
                Text { text: "Type CONFIRM to run it."; color: Theme.dim; }
                LineEdit { text <=> root.confirm-typed; }
                HorizontalLayout { spacing: 8px; alignment: end;
                    Button { text: "Cancel"; clicked => { root.confirm-cancel(); } }
                    Button { text: "Run"; enabled: root.confirm-typed == "CONFIRM"; clicked => { root.confirm-run(); } }
                }
            }
        }
    }
}
