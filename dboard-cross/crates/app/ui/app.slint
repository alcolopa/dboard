import { Palette, ComboBox } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Btn, Badge, Icons, IconBtn, Slot, Sep, EditLine, EditArea } from "widgets.slint";
import { SessionBar } from "sessions.slint";
import { ConnectionManager } from "connections.slint";
import { Sidebar } from "sidebar.slint";
import { TabBar } from "tabs.slint";
import { DataGrid } from "grid.slint";
import { QueryEditor, HistoryDrawer } from "query.slint";
import { Diagram } from "diagram.slint";
import { Inspector } from "inspector.slint";
import { Dialogs } from "dialogs.slint";
import { TextEdit, LineEdit } from "std-widgets.slint";
import "fonts/Inter_400Regular.ttf";
import "fonts/Inter_600SemiBold.ttf";
import "fonts/Inter_700Bold.ttf";
import "fonts/JetBrainsMono_400Regular.ttf";
import "fonts/JetBrainsMono_700Bold.ttf";

export { AppState, Theme, Palette }

component Workspace inherits VerticalLayout {
    TabBar { }
    if AppState.tab-kind == 0: VerticalLayout {
        HorizontalLayout {
            height: 44px; padding: 8px; spacing: 8px;
            Text { text: AppState.table-title; font-weight: 700; color: Theme.text; vertical-alignment: center; }
            EditLine {
                placeholder-text: AppState.db-type == 2 ? "Filter as JSON, e.g. {\"age\": {\"$gt\": 30}}" : "WHERE clause, e.g. id > 10";
                text <=> AppState.filter-text;
                accepted => { AppState.apply-filter(self.text); }
                horizontal-stretch: 1;
            }
            Btn { text: "Apply"; clicked => { AppState.apply-filter(AppState.filter-text); } }
        }
    }
    if AppState.tab-kind == 1: QueryEditor { vertical-stretch: 0; }
    if AppState.banner != "": Rectangle {
        height: 26px; background: AppState.banner-error ? Theme.err-bg : Theme.warn-bg;
        Text { x: 12px; width: parent.width - 24px; text: AppState.banner; color: AppState.banner-error ? Theme.err : Theme.warn; vertical-alignment: center; overflow: elide; }
    }
    if AppState.tab-kind == -1: Rectangle {
        vertical-stretch: 1;
        VerticalLayout {
            alignment: center; spacing: 8px;
            Text { text: "Open a table from the sidebar, or press " + Theme.mod + "+N for a new query."; color: Theme.dim; horizontal-alignment: center; }
            Text { text: Theme.mod + "+K command palette   ·   " + Theme.mod + "+P search objects   ·   " + Theme.mod + "+Tab next tab"; color: Theme.dim; font-size: 11px; horizontal-alignment: center; }
        }
    }
    if AppState.tab-kind == 4: Diagram { vertical-stretch: 1; }
    if AppState.tab-kind >= 0 && AppState.tab-kind != 3 && AppState.tab-kind != 4: DataGrid { vertical-stretch: 1; visible: AppState.cols.length > 0; }
    if AppState.tab-kind == 2 || AppState.tab-kind == 3: Rectangle {
        vertical-stretch: AppState.tab-kind == 3 ? 1 : 0;
        min-height: 100px;
        preferred-height: AppState.tab-kind == 3 ? 400px : 220px;
        background: Theme.panel; border-width: 1px; border-color: Theme.line;
        EditArea { width: parent.width; height: parent.height; read-only: true; text: AppState.ddl-text; font-family: "JetBrains Mono"; font-size: AppState.set-font-size * 1px; }
    }
    // footer
    if AppState.tab-kind >= 0: Rectangle {
        height: 42px; background: Theme.panel;
        Rectangle { y: 0px; height: 1px; background: Theme.line; }
        HorizontalLayout {
            padding-left: 10px; padding-right: 10px; spacing: 4px;
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.first; hint: "First page"; enabled: AppState.row-offset > 0; clicked => { AppState.first-page(); } } }
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.prev; hint: "Previous page"; enabled: AppState.row-offset > 0; clicked => { AppState.prev-page(); } } }
            if AppState.tab-kind == 0: Slot {
                ComboBox {
                    width: 84px; height: 28px; model: AppState.page-sizes; current-index: AppState.page-size-index;
                    selected => { AppState.set-page-size(self.current-index); }
                }
            }
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.next; hint: "Next page"; enabled: AppState.has-next; clicked => { AppState.next-page(); } } }
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.last; hint: "Last page"; clicked => { AppState.last-page(); } } }
            Rectangle { width: 6px; }
            Text {
                text: AppState.hint != "" ? AppState.hint : AppState.page-info + (AppState.tab-kind == 0 && AppState.timing != "" ? "  ·  " + AppState.timing : "");
                color: AppState.hint != "" ? Theme.text : Theme.dim;
                vertical-alignment: center; font-size: 12px; overflow: elide; horizontal-stretch: 1; min-width: 40px;
            }
            if AppState.tab-kind == 3: Slot { IconBtn { d: Icons.copy; hint: "Copy definition"; clicked => { AppState.copy-text(AppState.ddl-text); } } }
            if AppState.tab-kind == 0 && AppState.db-type == 2: Slot { IconBtn { d: Icons.edit; hint: "Edit document"; enabled: AppState.selected-row >= 0; clicked => { AppState.open-doc(AppState.selected-row); } } }
            if AppState.tab-kind == 0 && AppState.db-type != 2: Slot { IconBtn { d: Icons.edit; hint: "Edit row in a form"; enabled: AppState.selected-row >= 0 && AppState.editable; clicked => { AppState.open-edit-row(AppState.selected-row); } } }
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.plus; hint: "Add row"; primary: true; clicked => { AppState.open-insert(); } } }
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.trash; hint: "Delete selected row"; danger: true; enabled: AppState.selected-row >= 0 && AppState.editable; clicked => { AppState.delete-row(AppState.selected-row); } } }
            if AppState.tab-kind == 0 && AppState.db-type != 2: Slot { Btn { text: AppState.stage-on ? "Staging: on" : "Staging: off"; clicked => { AppState.stage-toggle(); } } }
            if AppState.tab-kind == 0 && AppState.pending-count > 0: Slot { Btn { text: "Review " + AppState.pending-count + " change(s)"; primary: true; clicked => { AppState.review-open-request(); } } }
            if (AppState.tab-kind == 0 && AppState.db-type != 2) || AppState.tab-kind == 5: Slot { IconBtn { d: Icons.search; hint: "Column filters (type in a column, press Enter)"; active: AppState.filter-row-open; clicked => { AppState.filter-row-open = !AppState.filter-row-open; } } }
            if AppState.tab-kind == 0: Slot { Sep { } }
            if AppState.tab-kind == 0: Slot { IconBtn { d: Icons.download; hint: "Import rows from a file"; clicked => { AppState.open-transfer(2); } } }
            if AppState.tab-kind == 0 || AppState.tab-kind == 1 || AppState.tab-kind == 5: Slot { IconBtn { d: Icons.pin; hint: "Pin this result so you can compare against it later"; enabled: AppState.rows.length > 0; clicked => { AppState.pin-result(); } } }
            if AppState.tab-kind == 0 || AppState.tab-kind == 1: Slot { Btn { text: "Compare with pinned"; clicked => { AppState.compare-result(); } } }
            if AppState.tab-kind == 0 || AppState.tab-kind == 1 || AppState.tab-kind == 5: Slot { IconBtn { d: Icons.upload; hint: "Export these rows"; enabled: AppState.rows.length > 0; clicked => { AppState.open-export(); } } }
        }
    }
}

export component App inherits Window {
    title: "dboard";
    icon: @image-url("../../../assets/icon.png");
    preferred-width: 1280px;
    preferred-height: 780px;
    min-width: 900px;
    min-height: 560px;
    background: Theme.bg;
    default-font-size: 13px;
    default-font-family: "Inter";
    init => { Palette.color-scheme = Theme.dark ? ColorScheme.dark : ColorScheme.light; }

    // Closing a dialog destroys its focused input; hand focus back so shortcuts keep working.
    property <bool> any-modal: AppState.confirm-open || AppState.insert-open || AppState.json-open || AppState.saveq-open
        || AppState.palette-open || AppState.export-open || AppState.settings-open || AppState.ctx-open
        || AppState.editrow-open || AppState.users-open || AppState.xfer-open || AppState.review-open || AppState.vars-open;
    changed any-modal => { AppState.text-focus = 0; if !self.any-modal { fs.focus(); } }
    // Switching screens / tab types destroys whatever widget held focus (login field, editor, filter box).
    property <int> focus-key: AppState.tab-kind * 10 + (AppState.connected ? 1 : 0);
    changed focus-key => { AppState.text-focus = 0; fs.focus(); }
    // Clicking a cell must pull focus out of whatever text box had it so Copy / Paste act on the grid.
    property <int> focus-token: AppState.focus-token;
    changed focus-token => { AppState.text-focus = 0; fs.focus(); }

    // Native menu bar on macOS (global top bar); other platforms get the same entries in-window.
    MenuBar {
        Menu {
            title: "File";
            MenuItem { title: "New Connection"; activated => { AppState.connected = false; AppState.new-conn(); } }
            MenuItem { title: "New Query"; enabled: AppState.connected; activated => { AppState.new-query-tab(); } }
            MenuItem { title: "Close Tab"; enabled: AppState.connected; activated => { AppState.close-tab(-1); } }
            MenuItem { title: "Reopen Closed Tab"; enabled: AppState.connected; activated => { AppState.reopen-tab(); } }
            MenuItem { title: "Disconnect"; enabled: AppState.connected; activated => { AppState.disconnect(); } }
            MenuItem { title: "Quit"; activated => { AppState.quit(); } }
        }
        Menu {
            title: "Edit";
            MenuItem { title: "Undo Last Change"; enabled: AppState.connected && AppState.undo-count > 0; activated => { AppState.undo(); } }
            MenuItem { title: "Cut"; activated => { AppState.edit(0); } }
            MenuItem { title: "Copy"; activated => { AppState.edit(1); } }
            MenuItem { title: "Paste"; activated => { AppState.edit(2); } }
            MenuItem { title: "Select All"; activated => { AppState.edit(3); } }
            MenuItem { title: "Settings…"; activated => { AppState.open-settings(); } }
        }
        Menu {
            title: "View";
            Menu {
                title: "Query Timeout";
                MenuItem { title: (AppState.timeout-secs == 0 ? "✓ " : "") + "Off"; activated => { AppState.set-timeout(0); } }
                MenuItem { title: (AppState.timeout-secs == 30 ? "✓ " : "") + "30 seconds"; activated => { AppState.set-timeout(30); } }
                MenuItem { title: (AppState.timeout-secs == 120 ? "✓ " : "") + "2 minutes"; activated => { AppState.set-timeout(120); } }
                MenuItem { title: (AppState.timeout-secs == 600 ? "✓ " : "") + "10 minutes"; activated => { AppState.set-timeout(600); } }
            }
            MenuItem { title: "Audit Log"; enabled: AppState.connected; activated => { AppState.open-audit(); } }
            MenuItem { title: "ER Diagram"; enabled: AppState.connected && AppState.db-type != 2; activated => { AppState.open-er(); } }
            MenuItem { title: "Refresh"; activated => { AppState.refresh(); } }
            MenuItem { title: "Toggle Inspector"; activated => { AppState.inspector-changed(!AppState.inspector-open, AppState.inspector-pinned); } }
            MenuItem { title: "Command Palette"; activated => { AppState.open-palette(false); } }
            MenuItem { title: "Search Objects"; activated => { AppState.open-palette(true); } }
        }
        Menu {
            title: "Help";
            MenuItem { title: "Check for Updates…"; activated => { AppState.check-updates(); } }
            MenuItem { title: "Release Notes"; activated => { AppState.open-link("https://github.com/alcolopa/dboard/releases"); } }
        }
        Menu {
            title: "Tab";
            MenuItem { title: "Next Tab"; activated => { AppState.cycle-tab(1); } }
            MenuItem { title: "Previous Tab"; activated => { AppState.cycle-tab(-1); } }
        }
    }

    forward-focus: fs;
    fs := FocusScope {
        // Shortcuts that must work even while a text field has focus. `control` is Ctrl on Windows
        // and Linux and Cmd on macOS (the toolkit maps it), so the same code gives native shortcuts.
        capture-key-pressed(e) => {
            if AppState.connected && e.modifiers.control && !any-modal {
                if e.text == "k" { AppState.open-palette(false); return accept; }
                if e.text == "p" { AppState.open-palette(true); return accept; }
                if (e.text == "t" || e.text == "T") && e.modifiers.shift { AppState.reopen-tab(); return accept; }
                if e.text == "n" || e.text == "t" { AppState.new-query-tab(); return accept; }
                if e.text == "w" { AppState.close-tab(-1); return accept; }
                if e.text == "r" { AppState.refresh(); return accept; }
                if e.text == "i" && e.modifiers.alt { AppState.inspector-changed(!AppState.inspector-open, AppState.inspector-pinned); return accept; }
                if e.text == "," { AppState.open-settings(); return accept; }
                if e.text == "s" && AppState.tab-kind == 1 { AppState.open-save-query(); return accept; }
                if e.text == "q" { AppState.quit(); return accept; }
                if e.text == Key.Tab { AppState.cycle-tab(e.modifiers.shift ? -1 : 1); return accept; }
                if e.text == Key.Backtab { AppState.cycle-tab(-1); return accept; }
                if e.text == "1" { AppState.activate-tab(0); return accept; }
                if e.text == "2" { AppState.activate-tab(1); return accept; }
                if e.text == "3" { AppState.activate-tab(2); return accept; }
                if e.text == "4" { AppState.activate-tab(3); return accept; }
                if e.text == "5" { AppState.activate-tab(4); return accept; }
                if e.text == "6" { AppState.activate-tab(5); return accept; }
                if e.text == "7" { AppState.activate-tab(6); return accept; }
                if e.text == "8" { AppState.activate-tab(7); return accept; }
                if e.text == "9" { AppState.activate-tab(AppState.tabs.length - 1); return accept; }
                if (e.text == Key.Return || e.text == "\n") && AppState.tab-kind == 1 { AppState.run-query(AppState.query-text); return accept; }
            }
            reject
        }
        // Grid shortcuts. Text fields consume their own keys first, so these only fire when the
        // grid (not a text box) is what the user is working in.
        key-pressed(e) => {
            if !AppState.connected || any-modal || (AppState.tab-kind != 0 && AppState.tab-kind != 1 && AppState.tab-kind != 2) { return reject; }
            if e.modifiers.control {
                if e.text == "c" || e.text == "C" {
                    if AppState.sel-kind == 0 { return reject; }
                    AppState.copy-selection(AppState.sel-r0, AppState.sel-c0, AppState.sel-r1, AppState.sel-c1, e.modifiers.shift ? 1 : 0);
                    return accept;
                }
                if e.text == "v" || e.text == "V" {
                    if AppState.sel-kind == 0 { return reject; }
                    AppState.paste-selection(AppState.sel-r0, AppState.sel-c0, AppState.sel-r1, AppState.sel-c1);
                    return accept;
                }
                if e.text == "a" || e.text == "A" { AppState.select-all(); return accept; }
                if (e.text == "z" || e.text == "Z") && !e.modifiers.shift { AppState.undo(); return accept; }
                return reject;
            }
            if e.text == Key.UpArrow { AppState.move-selection(-1, 0, e.modifiers.shift); return accept; }
            if e.text == Key.DownArrow { AppState.move-selection(1, 0, e.modifiers.shift); return accept; }
            if e.text == Key.LeftArrow { AppState.move-selection(0, -1, e.modifiers.shift); return accept; }
            if e.text == Key.RightArrow { AppState.move-selection(0, 1, e.modifiers.shift); return accept; }
            if (e.text == Key.Return || e.text == Key.F2) && AppState.sel-kind == 1 && AppState.editable {
                AppState.request-edit(AppState.sel-r1, AppState.sel-c1);
                return accept;
            }
            if e.text == Key.Escape && AppState.sel-kind != 0 { AppState.clear-selection(); return accept; }
            reject
        }

        if !AppState.connected: VerticalLayout {
            if AppState.sessions.length > 0: SessionBar { }
            ConnectionManager { vertical-stretch: 1; }
        }

        if AppState.connected: VerticalLayout {
            SessionBar { }
            // Production gets an unmissable banner; every other environment a thin coloured strip.
            if AppState.env-label == "Production": Rectangle {
                height: 18px; background: AppState.env-color;
                Text { text: "PRODUCTION DATABASE — changes here affect real data"; color: white; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
            }
            if AppState.env-label != "Production": Rectangle { height: 2px; background: AppState.env-color; }
            // ---- top bar ----
            Rectangle {
                height: 44px; background: Theme.panel;
                HorizontalLayout {
                    padding-left: 12px; padding-right: 12px; spacing: 8px;
                    Slot {
                        Rectangle {
                            width: envl.preferred-width + 18px; height: 22px; border-radius: 11px; background: AppState.env-color;
                            envl := Text { text: AppState.env-label; color: white; font-size: 11px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if AppState.databases.length > 0: Slot {
                        ComboBox {
                            width: 190px; height: 28px;
                            model: AppState.databases;
                            current-index: AppState.database-index;
                            selected => { AppState.switch-database(self.current-index); }
                        }
                    }
                    Text {
                        text: AppState.hint != "" ? AppState.hint : AppState.status;
                        color: AppState.hint != "" ? Theme.text : Theme.dim;
                        vertical-alignment: center; overflow: elide; font-size: 12px; horizontal-stretch: 1; min-width: 40px;
                    }
                    if AppState.read-only: Slot {
                        Rectangle {
                            width: rol.preferred-width + 18px; height: 22px; border-radius: 11px; background: Theme.panel2; border-width: 1px; border-color: Theme.line;
                            rol := Text { text: "READ-ONLY"; color: Theme.dim; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if AppState.running: Slot { Btn { text: "Stop query"; danger: true; clicked => { AppState.stop-query(); } } }
                    if AppState.db-type != 2 && !AppState.in-tx: Slot { Btn { text: "Begin transaction"; clicked => { AppState.tx-begin(); } } }
                    if AppState.in-tx: Slot {
                        Rectangle {
                            width: txl.preferred-width + 18px; height: 22px; border-radius: 11px; background: Theme.warn;
                            txl := Text { text: "IN TRANSACTION"; color: black; font-size: 10px; font-weight: 700; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                    if AppState.in-tx: Slot { Btn { text: "Commit"; primary: true; clicked => { AppState.tx-commit(); } } }
                    if AppState.in-tx: Slot { Btn { text: "Rollback"; danger: true; clicked => { AppState.tx-rollback(); } } }
                    Slot { IconBtn { d: Icons.undo; hint: "Undo last change (" + Theme.mod + "+Z)"; badge: AppState.undo-count; enabled: AppState.undo-count > 0; clicked => { AppState.undo(); } } }
                    Slot { IconBtn { d: Icons.history; hint: "Query history & saved queries"; active: AppState.drawer-open; clicked => { AppState.drawer-open = !AppState.drawer-open; } } }
                    Slot {
                        dbbtn := IconBtn {
                            d: Icons.database; hint: "Database tools: users, export, import";
                            clicked => { AppState.ctx("dbmenu", 0, 0, self.absolute-position.x, self.absolute-position.y + self.height); }
                        }
                    }
                    Slot { IconBtn { d: Icons.inspector; hint: "Inspector"; active: AppState.inspector-open; clicked => { AppState.inspector-changed(!AppState.inspector-open, AppState.inspector-pinned); } } }
                    Slot { IconBtn { d: Icons.settings; hint: "Settings (" + Theme.mod + "+,)"; clicked => { AppState.open-settings(); } } }
                    Slot { IconBtn { d: Icons.power; hint: "Disconnect"; danger: true; clicked => { AppState.close-session(-1); } } }
                }
            }
            Rectangle {
                vertical-stretch: 1;
                // Pinned: docked beside the workspace. Unpinned: floats over it and closes on an outside click.
                property <bool> docked: AppState.inspector-open && AppState.inspector-pinned;
                property <length> inspector-w: docked ? 321px : 0px;
                Sidebar { x: 0px; width: 270px; height: parent.height; }
                Rectangle { x: 270px; width: 1px; height: parent.height; background: Theme.line; }
                Rectangle {
                    x: 271px;
                    width: parent.width - 271px - parent.inspector-w;
                    height: parent.height;
                    Workspace { width: parent.width; height: parent.height; }
                    if AppState.drawer-open: HistoryDrawer {
                        x: parent.width - self.width; height: parent.height;
                    }
                }
                if AppState.inspector-open && !AppState.inspector-pinned: TouchArea {
                    x: 271px; width: parent.width - 271px;
                    clicked => { AppState.inspector-changed(false, false); }
                }
                if docked: Rectangle { x: parent.width - 321px; width: 1px; height: parent.height; background: Theme.line; }
                if AppState.inspector-open: Inspector { x: parent.width - 320px; height: parent.height; }
            }
        }

        Dialogs { }
    }
}
