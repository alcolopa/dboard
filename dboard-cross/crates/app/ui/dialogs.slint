import { LineEdit, ComboBox, CheckBox, TextEdit, ListView, SpinBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Btn, Modal, EditLine, EditArea } from "widgets.slint";

component Title inherits Text { font-size: 15px; font-weight: 700; color: Theme.text; wrap: word-wrap; }
component Note inherits Text { color: Theme.dim; font-size: 12px; wrap: word-wrap; }


component SettingsRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    min-height: 78px;
    HorizontalLayout {
        padding: 14px; spacing: 18px;
        VerticalLayout {
            horizontal-stretch: 1; alignment: center; spacing: 5px;
            Text { text: root.label; color: Theme.text; font-size: 13px; font-weight: 600; wrap: word-wrap; }
            Note { text: root.detail; }
        }
        HorizontalLayout { width: 160px; alignment: center; @children }
    }
}

component PreferencesDialog inherits Modal {
    box-width: 600px;
    property <int> section: 0;
    property <bool> confirm-clear: false;
    callback persist();
    persist => { AppState.settings-changed(AppState.set-theme-index, AppState.set-compact, AppState.set-page-size-index, AppState.set-confirm, AppState.set-autocomplete, AppState.set-font-size); }
    dismissed => { AppState.settings-close(); }
    VerticalLayout {
        spacing: 6px;
        Text { text: "Preferences"; font-size: 22px; font-weight: 700; color: Theme.text; }
        Note { text: "A workspace that works your way."; }
    }
    HorizontalLayout {
        spacing: 4px;
        for name[i] in ["Appearance & data", "SQL editor", "Safety & passwords"]: Rectangle {
            height: 36px; horizontal-stretch: 1; min-width: 0px; border-radius: 6px;
            background: root.section == i ? Theme.sel : area.has-hover ? Theme.hover : Theme.clear;
            accessible-role: button; accessible-label: name;
            accessible-action-default => { root.section = i; }
            Text { text: name; color: root.section == i ? Theme.accent-text : Theme.dim; font-size: 12px; font-weight: root.section == i ? 600 : 400; horizontal-alignment: center; vertical-alignment: center; }
            border-width: navigation.has-focus ? 2px : 0px; border-color: Theme.accent-text;
            forward-focus: navigation;
            navigation := FocusScope {
                key-pressed(e) => {
                    if e.text == Key.Return || e.text == " " { root.section = i; return accept; }
                    if e.text == Key.RightArrow { root.section = mod(root.section + 1, 3); return accept; }
                    if e.text == Key.LeftArrow { root.section = mod(root.section + 2, 3); return accept; }
                    reject
                }
            }
            area := TouchArea { clicked => { navigation.focus(); root.section = i; } }
        }
    }
    Rectangle {
        height: 260px;
        ScrollView {
            width: parent.width; height: parent.height;
            horizontal-scrollbar-policy: always-off; viewport-width: self.visible-width;
            VerticalLayout {
                spacing: 12px; alignment: start;
                if root.section == 0: Rectangle {
                    background: Theme.panel2; border-radius: 8px;
                    VerticalLayout {
                        spacing: 0px;
                        SettingsRow {
                            label: "Color theme"; detail: "Choose your workspace colors.";
                            ComboBox { model: ["Green Dark", "Green Light", "Forest", "Sand"]; current-index <=> AppState.set-theme-index; selected => { root.persist(); } }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        SettingsRow {
                            label: "Compact rows"; detail: "Fit more records into the data grid.";
                            CheckBox { text: "Enabled"; checked <=> AppState.set-compact; toggled => { root.persist(); } }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        SettingsRow {
                            label: "Rows per page"; detail: "Default number of rows loaded per page.";
                            ComboBox { model: AppState.page-sizes; current-index <=> AppState.set-page-size-index; selected => { root.persist(); } }
                        }
                    }
                }
                if root.section == 1: Rectangle {
                    background: Theme.panel2; border-radius: 8px;
                    VerticalLayout {
                        spacing: 0px;
                        SettingsRow {
                            label: "Font size"; detail: "Query editor text size, in pixels.";
                            SpinBox { minimum: 9; maximum: 24; value <=> AppState.set-font-size; edited => { root.persist(); } }
                        }
                        Rectangle { height: 1px; background: Theme.line; }
                        SettingsRow {
                            label: "SQL autocomplete"; detail: "Show suggestions as you write queries.";
                            CheckBox { text: "Enabled"; checked <=> AppState.set-autocomplete; toggled => { root.persist(); } }
                        }
                    }
                }
                if root.section == 2: VerticalLayout {
                    spacing: 12px;
                    Rectangle {
                        background: Theme.panel2; border-radius: 8px;
                        SettingsRow {
                            label: "Confirm destructive statements"; detail: "Require confirmation on Production and Staging.";
                            CheckBox { text: "Enabled"; checked <=> AppState.set-confirm; toggled => { root.persist(); } }
                        }
                    }
                    Rectangle {
                        border-radius: 8px; border-width: 1px; border-color: Theme.line;
                        VerticalLayout {
                            padding: 14px; spacing: 10px;
                            Text { text: "Saved passwords"; color: Theme.text; font-size: 13px; font-weight: 600; }
                            Note { text: root.confirm-clear ? "Remove all stored passwords? You will need to enter them again when reconnecting." : "Remove stored credentials for all saved connections."; }
                            HorizontalLayout {
                                spacing: 8px;
                                if !root.confirm-clear: Btn { text: "Clear saved passwords…"; clicked => { root.confirm-clear = true; } }
                                if root.confirm-clear: Btn { text: "Remove passwords"; danger: true; clicked => { AppState.clear-credentials(); root.confirm-clear = false; } }
                                if root.confirm-clear: Btn { text: "Cancel"; clicked => { root.confirm-clear = false; } }
                                Rectangle { horizontal-stretch: 1; }
                            }
                        }
                    }
                    if AppState.set-info != "": Note { text: AppState.set-info; }
                }
            }
        }
    }
    Rectangle { height: 1px; background: Theme.line; }
    HorizontalLayout {
        spacing: 12px;
        Note { text: "Changes are saved automatically."; horizontal-stretch: 1; vertical-alignment: center; }
        Btn { text: "Done"; width: 80px; height: 32px; primary: true; clicked => { AppState.settings-close(); } }
    }
}

// Access levels are cumulative: Write includes Read, and Full includes both.
component AccessCheckboxes inherits VerticalLayout {
    in-out property <int> level: 1;
    in property <bool> editable: true;
    spacing: 6px;
    HorizontalLayout {
        spacing: 16px;
        CheckBox {
            text: "Read";
            checked: root.level >= 1;
            enabled: root.editable;
            toggled => { root.level = root.level >= 1 ? 0 : 1; }
        }
        CheckBox {
            text: "Write";
            checked: root.level >= 2;
            enabled: root.editable;
            toggled => { root.level = root.level >= 2 ? 1 : 2; }
        }
        CheckBox {
            text: "Full access";
            checked: root.level == 3;
            enabled: root.editable;
            toggled => { root.level = root.level == 3 ? 2 : 3; }
        }
    }
    Note { text: "Write includes Read. Full access includes both. Uncheck Read to remove access."; }
}

component UsersDialog inherits Modal {
    box-width: 860px;
    property <string> nu-name;
    property <string> nu-host: "%";
    property <string> nu-pw;
    property <int> nu-level: 1;
    property <bool> advanced: false;
    property <string> database: AppState.user-db-index >= 0 && AppState.user-db-index < AppState.user-databases.length ? AppState.user-databases[AppState.user-db-index] : "";
    property <string> pw-new;
    property <int> access-tab: 0;
    dismissed => { AppState.users-close(); }
    HorizontalLayout {
        Title { text: "Users & access"; vertical-alignment: center; }
        Rectangle { horizontal-stretch: 1; }
        Btn { text: "Close"; clicked => { AppState.users-close(); } }
    }
    Note { text: AppState.user-scope; }
    HorizontalLayout {
        spacing: 10px;
        Text { text: "Database"; color: Theme.text; vertical-alignment: center; }
        ComboBox { model: AppState.user-databases; current-index <=> AppState.user-db-index; horizontal-stretch: 1; enabled: !AppState.user-busy; selected => { root.pw-new = ""; if AppState.user-sel >= 0 { AppState.user-select(AppState.user-sel, root.database); } } }
    }
    if root.database == "": Note { text: "Select a database to grant access."; }
    HorizontalLayout {
        spacing: 14px;
        height: min(450px, max(240px, root.height - 240px));
        // ---- list ----
        VerticalLayout {
            width: 250px; spacing: 6px;
            if AppState.user-can-manage: Btn { text: "+ Add user"; primary: true; enabled: !AppState.user-busy; clicked => { root.nu-name = ""; root.nu-pw = ""; root.nu-host = "%"; root.nu-level = 1; root.advanced = false; AppState.user-create-open = true; AppState.user-info = ""; } }
            Rectangle {
                vertical-stretch: 1; border-width: 1px; border-color: Theme.line; border-radius: 6px; clip: true;
                ListView {
                    for u[i] in AppState.users: Rectangle {
                        height: 42px;
                        background: !AppState.user-create-open && i == AppState.user-sel ? Theme.sel : (ua.has-hover ? Theme.hover : Theme.clear);
                        VerticalLayout {
                            x: 10px; width: parent.width - 16px; alignment: center;
                            Text { text: u.name; color: Theme.text; overflow: elide; font-weight: 600; }
                            Text { text: u.detail; color: Theme.dim; font-size: 10px; overflow: elide; }
                        }
                        ua := TouchArea { enabled: !AppState.user-busy; clicked => { root.pw-new = ""; root.access-tab = 0; root.advanced = false; AppState.user-create-open = false; AppState.user-select(i, root.database); } }
                    }
                }
            }
        }
        // ---- create ----
        if AppState.user-create-open: VerticalLayout {
            horizontal-stretch: 1; spacing: 8px; alignment: start;
            Text { text: "New user"; font-weight: 700; color: Theme.text; font-size: 14px; }
            Text { text: "User name"; color: Theme.dim; font-size: 11px; }
            EditLine { text <=> root.nu-name; placeholder-text: "e.g. report_reader"; }
            if root.advanced && AppState.user-is-mysql: Text { text: "Allowed from host (% = anywhere)"; color: Theme.dim; font-size: 11px; }
            if root.advanced && AppState.user-is-mysql: EditLine { text <=> root.nu-host; }
            Text { text: "Password"; color: Theme.dim; font-size: 11px; }
            EditLine { text <=> root.nu-pw; input-type: InputType.password; }
            Text { text: "Access level"; color: Theme.dim; font-size: 11px; }
            AccessCheckboxes { level <=> root.nu-level; editable: !AppState.user-busy; }
            Note { text: root.nu-level == 0 ? "No permissions will be granted." : (root.nu-level == 1 ? "Can view data. Cannot change or delete it." : (root.nu-level == 2 ? "Can view, add, edit and delete data." : "Can manage data and database objects.")); }
            CheckBox { text: "Advanced options"; checked <=> root.advanced; }
            HorizontalLayout {
                spacing: 8px;
                Btn { text: "Create user & save access"; primary: true; enabled: root.nu-name != "" && root.nu-pw != "" && root.database != "" && !AppState.user-busy; clicked => { AppState.user-create(root.nu-name, root.nu-host, root.nu-pw, root.nu-level, false, root.database); root.nu-pw = ""; } }
                Btn { text: "Cancel"; clicked => { AppState.user-create-open = false; } }
            }
        }
        // ---- detail ----
        if !AppState.user-create-open && AppState.user-sel >= 0 && AppState.user-sel < AppState.users.length: VerticalLayout {
            horizontal-stretch: 1; spacing: 8px;
            Text { text: AppState.users[AppState.user-sel].name; font-weight: 700; color: Theme.text; font-size: 15px; overflow: elide; }
            Text { text: AppState.users[AppState.user-sel].detail; color: Theme.dim; font-size: 11px; wrap: word-wrap; }
            HorizontalLayout {
                spacing: 6px;
                Btn { text: "Database access"; primary: root.access-tab == 0; clicked => { root.access-tab = 0; } }
                if AppState.user-is-pg || AppState.user-is-mysql: Btn { text: "Table access"; primary: root.access-tab == 1; clicked => { root.access-tab = 1; } }
                Btn { text: "Permissions"; primary: root.access-tab == 2; clicked => { root.access-tab = 2; } }
            }
            if root.access-tab == 0: VerticalLayout {
                spacing: 8px;
                if AppState.user-level < 0: Note { text: "Current access is custom or differs between tables. Choose a level to replace the database grants."; }
                AccessCheckboxes { level <=> AppState.user-level; editable: AppState.user-can-manage && !AppState.user-busy; }
                if AppState.user-can-manage: Btn { text: "Save database access"; primary: true; enabled: root.database != "" && AppState.user-level >= 0 && !AppState.user-busy; clicked => { AppState.user-set-level(AppState.user-sel, AppState.user-level, root.database); } }
            }
            if root.access-tab == 1: VerticalLayout {
                spacing: 8px;
                ComboBox { model: AppState.user-tables; current-index <=> AppState.user-table-index; enabled: !AppState.user-busy; selected => { AppState.user-table-level = AppState.user-table-levels[AppState.user-table-index]; } }
                if AppState.user-table-index >= 0: VerticalLayout {
                    spacing: 8px;
                    if AppState.user-table-level < 0: Note { text: "This table has custom permissions. Choose a level to replace its direct grants."; }
                    AccessCheckboxes { level <=> AppState.user-table-level; editable: AppState.user-can-manage && !AppState.user-busy; }
                    if AppState.user-can-manage: Btn { text: "Save table access"; primary: true; enabled: AppState.user-table-level >= 0 && !AppState.user-busy; clicked => { AppState.user-set-table(AppState.user-sel, AppState.user-table-level, root.database, AppState.user-table-index); } }
                }
                Note { text: "The picker shows effective access. Database, ownership and inherited grants can provide broader access than the direct table grants."; }
            }
            if root.access-tab == 2: Rectangle {
                vertical-stretch: 1; min-height: 100px; border-width: 1px; border-color: Theme.line; border-radius: 6px; clip: true;
                ListView { for g in AppState.user-grants: Text { text: g; color: Theme.text; font-size: 11px; wrap: word-wrap; x: 8px; width: parent.width - 16px; } }
            }
            Rectangle { vertical-stretch: 1; }
            if AppState.user-can-password: HorizontalLayout {
                spacing: 8px;
                EditLine { text <=> root.pw-new; placeholder-text: "New password"; input-type: InputType.password; horizontal-stretch: 1; enabled: !AppState.user-busy; }
                Btn { text: "Change password"; enabled: root.pw-new != "" && !AppState.user-busy; clicked => { AppState.user-password(AppState.user-sel, root.pw-new); root.pw-new = ""; } }
            }
            if AppState.user-can-manage: Btn { text: "Delete user"; danger: true; enabled: !AppState.user-busy; clicked => { AppState.user-drop(AppState.user-sel); } }

        }
        if !AppState.user-create-open && (AppState.user-sel < 0 || AppState.user-sel >= AppState.users.length): Rectangle {
            horizontal-stretch: 1;
            Text { text: AppState.users.length == 0 ? "No users to show." : "Pick a user on the left, or add a new one."; color: Theme.dim; horizontal-alignment: center; vertical-alignment: center; }
        }
    }
    if AppState.user-error != "": Text { text: AppState.user-error; color: Theme.err; wrap: word-wrap; font-size: 12px; }
    if AppState.user-info != "": Text { text: AppState.user-info; color: Theme.ok; wrap: word-wrap; font-size: 12px; }
}

component TransferDialog inherits Modal {
    box-width: 560px;
    dismissed => { if !AppState.xfer-busy { AppState.xfer-cancel(); } }
    Title { text: AppState.xfer-title; }
    Note { text: AppState.xfer-note; }
    HorizontalLayout {
        spacing: 8px;
        EditLine {
            text <=> AppState.xfer-path; horizontal-stretch: 1;
            placeholder-text: AppState.xfer-mode == 0 ? "Where to save the export" : "Path of the file to import";
            enabled: !AppState.xfer-busy;
            accepted(t) => { if AppState.xfer-mode == 2 { AppState.xfer-preview-request(t, AppState.xfer-opt-a); } }
        }
        Btn { text: "Browse…"; enabled: !AppState.xfer-busy; clicked => { AppState.xfer-browse(); } }
    }
    if AppState.xfer-mode == 0: HorizontalLayout {
        spacing: 8px;
        Text { text: "Format"; color: Theme.dim; vertical-alignment: center; }
        ComboBox {
            model: AppState.xfer-formats; current-index <=> AppState.xfer-format; width: 160px;
            enabled: !AppState.xfer-busy;
            selected => { AppState.xfer-format-changed(self.current-index, AppState.xfer-path); }
        }
    }
    if AppState.xfer-mode == 0 && AppState.xfer-format == 0 && !AppState.xfer-scoped: CheckBox { text: "Structure (tables, views, routines, triggers, indexes)"; checked <=> AppState.xfer-opt-a; enabled: !AppState.xfer-busy; }
    if AppState.xfer-mode == 0 && AppState.xfer-format == 0 && !AppState.xfer-scoped: CheckBox { text: "Data (all rows)"; checked <=> AppState.xfer-opt-b; enabled: !AppState.xfer-busy; }
    if AppState.xfer-mode == 1: CheckBox { text: "Stop at the first error"; checked <=> AppState.xfer-opt-a; enabled: !AppState.xfer-busy; }
    if AppState.xfer-mode == 2: CheckBox { text: "First CSV row holds the column names"; checked <=> AppState.xfer-opt-a; enabled: !AppState.xfer-busy; toggled => { AppState.xfer-preview-request(AppState.xfer-path, AppState.xfer-opt-a); } }
    if AppState.xfer-mode == 2: CheckBox { text: "Stop at the first bad record (otherwise skip it and write an error report)"; checked <=> AppState.xfer-opt-b; enabled: !AppState.xfer-busy; }
    if AppState.xfer-mode == 2 && AppState.xfer-map-files.length > 0: VerticalLayout {
        spacing: 4px;
        Text { text: "Map file columns to table columns"; color: Theme.dim; font-size: 11px; font-weight: 700; }
        ListView {
            height: min(170px, AppState.xfer-map-files.length * 34px);
            for f[i] in AppState.xfer-map-files: HorizontalLayout {
                height: 34px; spacing: 8px;
                Text { text: f; width: 180px; overflow: elide; vertical-alignment: center; color: Theme.text; font-size: 12px; }
                Text { text: "→"; color: Theme.dim; vertical-alignment: center; }
                ComboBox {
                    model: AppState.xfer-map-targets; current-index: AppState.xfer-map-sel[i];
                    enabled: !AppState.xfer-busy;
                    selected => { AppState.xfer-map-pick(i, self.current-index); }
                }
            }
        }
        if AppState.xfer-preview != "": Text { text: AppState.xfer-preview; color: Theme.dim; font-size: 10px; font-family: "JetBrains Mono"; wrap: word-wrap; }
    }
    if AppState.xfer-busy && AppState.xfer-progress >= 0: HorizontalLayout {
        spacing: 8px; height: 14px;
        Rectangle {
            horizontal-stretch: 1; height: 8px; y: 3px; border-radius: 4px; background: Theme.panel2; border-width: 1px; border-color: Theme.line;
            Rectangle { x: 0; width: parent.width * AppState.xfer-progress; height: parent.height; border-radius: 4px; background: Theme.accent; }
        }
        Text { text: round(AppState.xfer-progress * 100) + "%"; color: Theme.dim; font-size: 11px; width: 36px; horizontal-alignment: right; }
    }
    if AppState.xfer-info != "": Text { text: AppState.xfer-info; color: AppState.xfer-busy ? Theme.dim : Theme.ok; wrap: word-wrap; font-size: 12px; }
    if AppState.xfer-error != "": Text { text: AppState.xfer-error; color: Theme.err; wrap: word-wrap; font-size: 12px; }
    HorizontalLayout {
        spacing: 8px; alignment: end;
        Btn { text: AppState.xfer-busy ? "Working…" : "Close"; enabled: !AppState.xfer-busy; clicked => { AppState.xfer-cancel(); } }
        Btn {
            text: AppState.xfer-mode == 0 ? "Export" : "Import"; primary: true;
            enabled: !AppState.xfer-busy && AppState.xfer-path != "";
            clicked => { AppState.xfer-run(AppState.xfer-path, AppState.xfer-opt-a, AppState.xfer-opt-b); }
        }
    }
}

export component Dialogs inherits Rectangle {
    // ---- context menu ----
    if AppState.ctx-open: Rectangle {
        TouchArea {
            clicked => { AppState.ctx-close(); }
            pointer-event(e) => { if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { AppState.ctx-close(); } }
        }
        Rectangle {
            x: max(4px, min(AppState.ctx-x, parent.width - self.width - 4px));
            y: max(4px, min(AppState.ctx-y, parent.height - self.height - 4px));
            width: min(280px, parent.width - 8px);
            height: min(menu.preferred-height + 8px, parent.height - 8px);
            clip: true;
            background: Theme.panel; border-radius: 6px; border-width: 1px; border-color: Theme.line;
            drop-shadow-blur: 12px; drop-shadow-color: Theme.shadow; drop-shadow-offset-y: 4px;
            ScrollView {
                x: 4px; y: 4px; width: parent.width - 8px; height: parent.height - 8px;
                viewport-width: self.visible-width; horizontal-scrollbar-policy: always-off;
                menu := VerticalLayout {
                spacing: 0px;
                for it in AppState.ctx-items: Rectangle {
                    height: it.sep ? 9px : 26px;
                    if it.sep: Rectangle { y: 4px; height: 1px; background: Theme.line; }
                    if !it.sep: Rectangle {
                        border-radius: 4px;
                        background: ia.has-hover ? Theme.hover : Theme.clear;
                        Text { x: 10px; width: parent.width - 20px; overflow: elide; text: it.label; color: it.danger ? Theme.err : Theme.text; vertical-alignment: center; font-size: 12px; }
                        ia := TouchArea { clicked => { AppState.ctx-pick(it.action, AppState.sel-r0, AppState.sel-c0, AppState.sel-r1, AppState.sel-c1); } }
                    }
                }
                }
            }
        }
    }

    // ---- review staged edits (old -> new) ----
    if AppState.review-open: Modal {
        box-width: 640px;
        dismissed => { AppState.review-cancel(); }
        Title { text: "Save " + AppState.pending-count + " pending change(s)"; }
        Note { text: "These edits are saved together. If any fails, none are kept. Inside an open transaction they stay uncommitted until you Commit."; }
        ListView {
            height: min(320px, AppState.review-items.length * 46px);
            for it in AppState.review-items: Rectangle {
                height: 46px;
                VerticalLayout {
                    alignment: center; spacing: 1px;
                    Text { text: it.text; color: Theme.text; overflow: elide; font-size: 12px; }
                    Text { text: it.detail; color: Theme.warn; overflow: elide; font-size: 11px; font-family: "JetBrains Mono"; }
                }
            }
        }
        if AppState.review-error != "": Text { text: AppState.review-error; color: Theme.err; wrap: word-wrap; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Discard all"; danger: true; clicked => { AppState.review-discard(); } }
            Btn { text: "Keep editing"; clicked => { AppState.review-cancel(); } }
            Btn { text: "Save changes"; primary: true; clicked => { AppState.review-apply(); } }
        }
    }

    // ---- query variables ----
    if AppState.vars-open: Modal {
        box-width: 480px;
        dismissed => { AppState.vars-cancel(); }
        Title { text: "Query variables"; }
        Note { text: "Values replace the {{placeholders}} in the query text. They are inserted as written, so add quotes in the query where needed."; }
        ListView {
            height: min(300px, AppState.vars-items.length * 54px);
            for f[i] in AppState.vars-items: VerticalLayout {
                height: 54px; spacing: 3px;
                Text { text: f.name; color: Theme.dim; font-size: 11px; overflow: elide; }
                EditLine { placeholder-text: f.hint; text: f.value; edited(t) => { AppState.vars-edited(i, t); } }
            }
        }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.vars-cancel(); } }
            Btn { text: "Run"; primary: true; clicked => { AppState.vars-submit(); } }
        }
    }

    // ---- insert row ----
    if AppState.insert-open: Modal {
        box-width: 520px;
        dismissed => { AppState.insert-cancel(); }
        Title { text: AppState.insert-title; }
        Note { text: "Leave a field empty to use its default / auto value."; }
        ListView {
            height: min(360px, AppState.insert-fields.length * 54px);
            for f[i] in AppState.insert-fields: VerticalLayout {
                height: 54px; spacing: 3px;
                Text { text: f.name + "   " + f.type-name; color: Theme.dim; font-size: 11px; overflow: elide; }
                EditLine { placeholder-text: f.hint; edited(t) => { AppState.insert-field-edited(i, t); } }
            }
        }
        if AppState.insert-error != "": Text { text: AppState.insert-error; color: Theme.err; wrap: word-wrap; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.insert-cancel(); } }
            Btn { text: "Insert"; primary: true; clicked => { AppState.insert-submit(); } }
        }
    }

    // ---- JSON / document editor ----
    if AppState.json-open: Modal {
        box-width: 680px;
        dismissed => { AppState.json-cancel(); }
        Title { text: AppState.json-title; }
        Rectangle {
            height: 320px; border-width: 1px; border-color: Theme.line; border-radius: 6px;
            EditArea { width: parent.width; height: parent.height; text <=> AppState.json-text; font-size: 12px; }
        }
        if AppState.json-error != "": Text { text: AppState.json-error; color: Theme.err; wrap: word-wrap; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px;
            Btn { text: "Format"; clicked => { AppState.json-format(AppState.json-text); } }
            Rectangle { horizontal-stretch: 1; }
            Btn { text: "Cancel"; clicked => { AppState.json-cancel(); } }
            Btn { text: "Save"; primary: true; clicked => { AppState.json-save(AppState.json-text); } }
        }
    }

    // ---- new database ----
    if AppState.new-db-open: Modal {
        box-width: 420px;
        dismissed => { AppState.new-db-cancel(); }
        Title { text: "New database"; }
        Note { text: "Creates an empty database on this server and switches to it. MongoDB creates it when you first write to it."; }
        EditLine { placeholder-text: "Database name"; text <=> AppState.new-db-name; accepted(t) => { if t != "" { AppState.new-db-submit(t); } } }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.new-db-cancel(); } }
            Btn { text: "Create"; primary: true; enabled: AppState.new-db-name != ""; clicked => { AppState.new-db-submit(AppState.new-db-name); } }
        }
    }

    // ---- save query ----
    if AppState.saveq-open: Modal {
        box-width: 420px;
        dismissed => { AppState.saveq-cancel(); }
        Title { text: "Save query"; }
        EditLine { placeholder-text: "Name"; text <=> AppState.saveq-name; }
        ComboBox { model: AppState.folders; current-index <=> AppState.saveq-folder; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.saveq-cancel(); } }
            Btn { text: "Save"; primary: true; enabled: AppState.saveq-name != ""; clicked => { AppState.saveq-submit(AppState.saveq-name, AppState.saveq-folder); } }
        }
    }

    // ---- export ----
    if AppState.export-open: Modal {
        box-width: 420px;
        dismissed => { AppState.export-cancel(); }
        Title { text: "Export data"; }
        Note { text: AppState.export-info; }
        ComboBox { model: AppState.export-formats; current-index <=> AppState.export-format; }
        CheckBox { text: "Include column header row"; checked <=> AppState.export-headers; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.export-cancel(); } }
            Btn { text: "Copy to clipboard"; clicked => { AppState.export-copy(AppState.export-format, AppState.export-headers); } }
            Btn { text: "Save to Downloads"; primary: true; clicked => { AppState.export-save(AppState.export-format, AppState.export-headers); } }
        }
    }

    // ---- settings ----
    if AppState.settings-open: PreferencesDialog { }

    // ---- edit a whole row ----
    if AppState.editrow-open: Modal {
        box-width: 560px;
        dismissed => { AppState.editrow-cancel(); }
        Title { text: AppState.editrow-title; }
        Note { text: "Change any fields, then Save. Only the fields you changed are written, and each change can be undone from History."; }
        ListView {
            height: min(400px, AppState.editrow-fields.length * 58px);
            for f[i] in AppState.editrow-fields: VerticalLayout {
                height: 58px; spacing: 3px;
                Text { text: f.name + "   " + f.type-name; color: Theme.dim; font-size: 11px; overflow: elide; }
                HorizontalLayout {
                    spacing: 6px;
                    EditLine {
                        text: f.value; enabled: !f.is-null; placeholder-text: f.is-null ? "NULL" : f.hint;
                        horizontal-stretch: 1;
                        edited(t) => { AppState.editrow-field-edited(i, t); }
                    }
                    Rectangle {
                        width: 52px; height: 32px; border-radius: 5px;
                        background: f.is-null ? Theme.accent : (na.has-hover ? Theme.hover : Theme.panel2);
                        Text { text: "NULL"; font-size: 11px; color: f.is-null ? Theme.on-accent : Theme.text; horizontal-alignment: center; vertical-alignment: center; }
                        na := TouchArea { clicked => { AppState.editrow-set-null(i, !f.is-null); } }
                    }
                }
            }
        }
        if AppState.editrow-error != "": Text { text: AppState.editrow-error; color: Theme.err; wrap: word-wrap; font-size: 12px; }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.editrow-cancel(); } }
            Btn { text: "Save"; primary: true; clicked => { AppState.editrow-submit(); } }
        }
    }

    // ---- users & access ----
    if AppState.users-open: UsersDialog { }

    // ---- export / import ----
    if AppState.xfer-open: TransferDialog { }

    // ---- destructive confirmation ----
    if AppState.confirm-open: Modal {
        border: Theme.err;
        dismissed => { AppState.confirm-cancel(); }
        Title { text: AppState.confirm-title; color: Theme.err; }
        Text { text: AppState.confirm-text; color: Theme.text; wrap: word-wrap; font-size: 12px; }
        if AppState.confirm-force-offer: CheckBox { text: "Force: ignore foreign keys and other integrity checks (also removes what depends on it)"; checked <=> AppState.confirm-force; }
        if AppState.confirm-typing: Note { text: "Type CONFIRM to proceed."; }
        if AppState.confirm-typing: EditLine { text <=> AppState.confirm-typed; accepted => { if AppState.confirm-typed == "CONFIRM" { AppState.confirm-run(AppState.confirm-force); } } }
        HorizontalLayout {
            spacing: 8px; alignment: end;
            Btn { text: "Cancel"; clicked => { AppState.confirm-cancel(); } }
            Btn { text: "Proceed"; danger: true; enabled: !AppState.confirm-typing || AppState.confirm-typed == "CONFIRM"; clicked => { AppState.confirm-run(AppState.confirm-force); } }
        }
    }

    // ---- command palette / global search ----
    if AppState.palette-open: Rectangle {
        background: Theme.modal-overlay;
        TouchArea { clicked => { AppState.palette-close(); } }
        FocusScope {
            capture-key-pressed(e) => {
                if e.text == Key.Escape { AppState.palette-close(); return accept; }
                if e.text == Key.DownArrow { AppState.palette-selected = min(AppState.palette-selected + 1, AppState.palette-items.length - 1); return accept; }
                if e.text == Key.UpArrow { AppState.palette-selected = max(AppState.palette-selected - 1, 0); return accept; }
                reject
            }
            Rectangle {
                y: 80px; width: min(620px, parent.width - 32px); height: min(460px, parent.height - 120px);
                background: Theme.panel; border-radius: 10px; border-width: 1px; border-color: Theme.line;
                TouchArea { }
                VerticalLayout {
                    padding: 12px; spacing: 8px;
                    pq := EditLine {
                        placeholder-text: AppState.palette-search-mode ? "Search tables, columns, routines, collections…" : "Type a command, table, saved query or connection…";
                        text <=> AppState.palette-query;
                        edited(t) => { AppState.palette-changed(t); }
                        accepted => { AppState.palette-run(AppState.palette-selected); }
                    }
                    ListView {
                        for it[i] in AppState.palette-items: Rectangle {
                            height: 40px; border-radius: 5px;
                            background: i == AppState.palette-selected ? Theme.panel2 : (pa.has-hover ? Theme.hover : Theme.clear);
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px; spacing: 10px;
                                VerticalLayout {
                                    alignment: center; horizontal-stretch: 1;
                                    Text { text: it.title; color: Theme.text; overflow: elide; }
                                    if it.subtitle != "": Text { text: it.subtitle; color: Theme.dim; font-size: 10px; overflow: elide; }
                                }
                                Text { text: it.kind; color: Theme.dim; font-size: 10px; vertical-alignment: center; }
                            }
                            pa := TouchArea { clicked => { AppState.palette-run(i); } }
                        }
                    }
                }
                init => { pq.focus(); }
            }
        }
    }

    // ---- toast ----
    if AppState.toast != "": Rectangle {
        y: parent.height - 64px;
        x: (parent.width - self.width) / 2;
        width: min(parent.width - 32px, 640px, tt.preferred-width + 32px);
        height: max(34px, tt.preferred-height + 20px);
        background: Theme.toast-bg; border-radius: 17px; opacity: 0.95;
        tt := Text { x: 16px; width: parent.width - 32px; text: AppState.toast; color: Theme.toast-text; font-size: 12px; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
    }
}
