import { LineEdit, ComboBox, CheckBox, ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { AppState } from "state.slint";
import { Btn, Badge, Icons, IconBtn, EditLine, EditArea } from "widgets.slint";

component Field inherits VerticalLayout {
    in property <string> label;
    spacing: 4px;
    Text { text: root.label; color: Theme.dim; font-size: 11px; }
    @children
}

export component ConnectionManager inherits Rectangle {
    background: Theme.bg;
    HorizontalLayout {
        // ---- saved connections ----
        Rectangle {
            width: 300px;
            background: Theme.panel;
            VerticalLayout {
                padding: 16px; spacing: 10px;
                HorizontalLayout {
                    Text { text: "Connections"; font-size: 16px; font-weight: 700; color: Theme.text; vertical-alignment: center; }
                    Rectangle { horizontal-stretch: 1; }
                    IconBtn { d: Icons.plus; hint: "New connection"; primary: true; clicked => { AppState.new-conn(); } }
                    Rectangle { width: 6px; }
                    IconBtn { d: Icons.settings; hint: "Settings"; clicked => { AppState.open-settings(); } }
                }
                EditLine { placeholder-text: "Search connections"; edited(t) => { AppState.conn-filter(t); } }
                if AppState.connections.length == 0: Text {
                    text: "No saved connections yet.\nFill in the form to add one.";
                    color: Theme.dim; wrap: word-wrap;
                }
                ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        for c in AppState.connections: Rectangle {
                            height: c.header ? 26px : 52px;
                            border-radius: 6px;
                            background: c.header ? transparent : (c.active ? Theme.panel2 : (ta.has-hover ? Theme.hover : transparent));
                            border-width: c.active && !c.header ? 1px : 0px;
                            border-color: Theme.accent;
                            if c.header: HorizontalLayout {
                                padding-left: 4px; spacing: 6px; alignment: start;
                                Rectangle { width: 8px; height: 8px; y: 9px; border-radius: 4px; background: c.color; }
                                Text { text: c.name; color: Theme.dim; font-size: 11px; font-weight: 700; vertical-alignment: center; }
                            }
                            if !c.header: Rectangle { x: 10px; y: 19px; width: 10px; height: 10px; border-radius: 5px; background: c.color; }
                            if !c.header: VerticalLayout {
                                x: 30px; width: parent.width - 40px; alignment: center; spacing: 2px;
                                Text { text: c.name; color: Theme.text; font-weight: 600; overflow: elide; }
                                Text { text: c.subtitle; color: Theme.dim; font-size: 11px; overflow: elide; }
                            }
                            ta := TouchArea {
                                enabled: !c.header;
                                clicked => { AppState.select-conn(c.id); }
                                double-clicked => { AppState.select-conn(c.id); AppState.connect-conn(AppState.form); }
                            }
                        }
                    }
                }
            }
        }
        Rectangle { width: 1px; background: Theme.line; }
        // ---- form ----
        ScrollView {
            horizontal-stretch: 1;
            VerticalLayout {
                padding: 28px; spacing: 12px; alignment: start;
                Text {
                    text: AppState.form-is-new ? "New connection" : "Edit connection";
                    font-size: 20px; font-weight: 700; color: Theme.text;
                }
                Text {
                    text: "Credentials are stored in your OS keyring, never in plain text on disk.";
                    color: Theme.dim; font-size: 11px; wrap: word-wrap;
                }
                Field {
                    label: "Connection name";
                    EditLine { placeholder-text: "e.g. Production replica"; text <=> AppState.form.name; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Field {
                        label: "Database engine";
                        ComboBox {
                            model: AppState.type-names;
                            current-index <=> AppState.form.type-index;
                            selected => { AppState.type-changed(self.current-index); }
                        }
                    }
                    Field {
                        label: "Environment";
                        ComboBox { model: AppState.env-names; current-index <=> AppState.form.env-index; }
                    }
                    Field {
                        label: "SSL / TLS";
                        ComboBox { model: AppState.ssl-names; current-index <=> AppState.form.ssl-index; }
                    }
                }
                if AppState.form-is-new && AppState.form.type-index != 2: Field {
                    label: "Paste a connection string and press Enter (optional)";
                    EditLine {
                        placeholder-text: "postgres://user:password@host:5432/database?sslmode=require";
                        accepted(t) => { AppState.parse-conn-url(t); }
                    }
                }
                if AppState.form.type-index == 2: Field {
                    label: "MongoDB connection string (optional, overrides the fields below)";
                    EditLine { placeholder-text: "mongodb://user@host:27017/dbname  or  mongodb+srv://…"; text <=> AppState.form.uri; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Field { label: "Host"; horizontal-stretch: 1; EditLine { placeholder-text: "host or IP"; text <=> AppState.form.host; } }
                    Field { label: "Port"; width: 170px; EditLine { text <=> AppState.form.port; } }
                }
                Field { label: "Database"; EditLine { placeholder-text: "database name (optional for MongoDB / MySQL)"; text <=> AppState.form.database; } }
                HorizontalLayout {
                    spacing: 12px;
                    Field { label: "Username"; horizontal-stretch: 1; EditLine { text <=> AppState.form.user; } }
                    Field { label: "Password"; horizontal-stretch: 1; EditLine { input-type: password; text <=> AppState.form.password; } }
                }
                if AppState.form.ssl-index > 0: HorizontalLayout {
                    spacing: 12px;
                    Field { label: "CA certificate (PEM, optional)"; horizontal-stretch: 1; EditLine { placeholder-text: "/path/to/ca.pem"; text <=> AppState.form.ssl-ca; } }
                    Field { label: "Client certificate (PEM, optional)"; horizontal-stretch: 1; EditLine { placeholder-text: "/path/to/client.pem"; text <=> AppState.form.ssl-cert; } }
                    if AppState.form.type-index == 0: Field { label: "Client key (PEM)"; horizontal-stretch: 1; EditLine { placeholder-text: "/path/to/client-key.pem"; text <=> AppState.form.ssl-key; } }
                }
                Rectangle {
                    height: 22px;
                    Text { text: (AppState.form.ssh-host != "" ? "▾" : "▸") + "  SSH tunnel (optional, uses your system ssh)"; color: Theme.dim; font-size: 11px; vertical-alignment: center; }
                }
                HorizontalLayout {
                    spacing: 12px;
                    Field { label: "SSH host (bastion)"; horizontal-stretch: 1; EditLine { placeholder-text: "leave empty for a direct connection"; text <=> AppState.form.ssh-host; } }
                    Field { label: "SSH port"; width: 110px; EditLine { placeholder-text: "22"; text <=> AppState.form.ssh-port; } }
                }
                if AppState.form.ssh-host != "": HorizontalLayout {
                    spacing: 12px;
                    Field { label: "SSH user"; horizontal-stretch: 1; EditLine { text <=> AppState.form.ssh-user; } }
                    Field { label: "Private key file (optional, else ssh-agent)"; horizontal-stretch: 1; EditLine { placeholder-text: "~/.ssh/id_ed25519"; text <=> AppState.form.ssh-key; } }
                }
                CheckBox { text: "Remember password in the OS keyring"; checked <=> AppState.form.remember; }
                if AppState.form.env-index <= 1: Rectangle {
                    height: 30px; background: Theme.warn-bg; border-radius: 5px;
                    Text {
                        x: 10px; width: parent.width - 20px;
                        text: "Destructive statements on this connection will require typed confirmation.";
                        color: Theme.warn; font-size: 11px; vertical-alignment: center; overflow: elide;
                    }
                }
                if AppState.form-error != "": Text { text: AppState.form-error; color: Theme.err; wrap: word-wrap; }
                if AppState.form-info != "": Text { text: AppState.form-info; color: AppState.form-info.character-count > 60 ? Theme.warn : Theme.ok; wrap: word-wrap; }
                HorizontalLayout {
                    spacing: 8px; alignment: start;
                    Btn { text: AppState.form-busy ? "Working…" : "Test connection"; enabled: !AppState.form-busy; clicked => { AppState.test-conn(AppState.form); } }
                    Btn { text: "Save"; enabled: !AppState.form-busy; clicked => { AppState.save-conn(AppState.form); } }
                    if !AppState.form-is-new: Btn { text: "Duplicate"; clicked => { AppState.duplicate-conn(AppState.form.id); } }
                    if !AppState.form-is-new: Btn { text: "Delete"; danger: true; clicked => { AppState.delete-conn(AppState.form.id); } }
                    Rectangle { width: 16px; }
                    Btn { text: AppState.busy ? "Connecting…" : "Connect"; primary: true; enabled: !AppState.busy && !AppState.form-busy; clicked => { AppState.connect-conn(AppState.form); } }
                }
            }
        }
    }
}
