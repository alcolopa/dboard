export global Theme {
    in-out property <bool> dark: true;
    in-out property <length> row-h: 26px;
    out property <color> bg: dark ? #0f1115 : #f4f5f8;
    out property <color> panel: dark ? #161922 : #ffffff;
    out property <color> panel2: dark ? #1d2230 : #eceef3;
    out property <color> hover: dark ? #1f2431 : #e6e9f0;
    out property <color> line: dark ? #262b38 : #d9dde6;
    out property <color> text: dark ? #e6e8ee : #1c2030;
    out property <color> dim: dark ? #8b91a3 : #667089;
    out property <color> accent: #5b7cfa;
    out property <color> ok: #10b981;
    out property <color> err: #ef4444;
    out property <color> warn: dark ? #f5c46b : #9a6b00;
    out property <color> warn-bg: dark ? #3a2a10 : #fdf1d6;
    out property <color> ok-bg: dark ? #10291f : #d8f5e8;
    out property <color> err-bg: dark ? #3a1519 : #fde3e3;
}
