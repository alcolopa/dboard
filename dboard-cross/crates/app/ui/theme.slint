export global Theme {
    in-out property <bool> dark: true;
    in-out property <length> row-h: 26px;
    out property <color> bg: dark ? #181a1f : #f5f6f8;
    out property <color> panel: dark ? #202228 : #ffffff;
    out property <color> panel2: dark ? #282b32 : #f0f2f5;
    out property <color> hover: dark ? #30343c : #e9edf2;
    out property <color> line: dark ? #353941 : #dde1e7;
    out property <color> text: dark ? #eceef2 : #252a33;
    out property <color> dim: dark ? #a1a7b3 : #697382;
    /// Modifier shown in hints; the app maps Cmd (macOS) and Ctrl (elsewhere) to the same shortcut.
    in property <string> mod: "Ctrl";
    out property <color> accent: #6489db;
    out property <color> text-selection: dark ? #405c91 : #b9cff4;
    out property <color> sel: dark ? #34435e : #e2ebfa;
    out property <color> ok: #55b795;
    out property <color> err: #e77575;
    out property <color> warn: dark ? #f5c46b : #9a6b00;
    out property <color> warn-bg: dark ? #3a2a10 : #fdf1d6;
    out property <color> ok-bg: dark ? #10291f : #d8f5e8;
    out property <color> err-bg: dark ? #3a1519 : #fde3e3;
}
